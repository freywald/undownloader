#!/bin/bash

# AUDIO QUEUE
#
# downloads audio files into an mka container file with thumbnails, subtitles & chapters all embedded
#
#

# CONFIGURATION
__configure_download \
`# run yt-dlp with these options:…` \
yt-dlp \
--live-from-start \
--no-restrict-filenames \
--compat-options no-clean-infojson \
--output-na-placeholder "UNKNOWN_PLACEHOLDER" \
`# show progress` \
--console-title --progress --newline \
`# output file template` \
--parse-metadata "description:(?s)(?P<meta_comment>.+)" \
-o "%(webpage_url_domain)s/audio/%(channel_id|uploader_id)s/%(id.0:2)s/%(id.2:4)s/%(id.4:6)s/%(id.6:2)s/%(id.8:2)s/%(id)s/%(id)s.%(ext)s" \
-o "%(webpage_url_domain)s/audio/%(id.0:2)s/%(id.2:4)s/%(id.4:6)s/%(id.6:2)s/%(id.8:2)s/%(id)s/%(id)s.%(ext)s" \
-o "pl_video:%(webpage_url_domain)s/playlists/%(playlist_id.2:2)s/%(playlist_id.4:2)s/%(playlist_id.6:2)s/%(playlist_id.8:2)s/%(playlist_id.10:2)s/%(playlist_id)s/%(id)s.%(ext)s" \
-o "pl_thumbnail:%(webpage_url_domain)s/playlists/%(playlist_id.2:2)s/%(playlist_id.4:2)s/%(playlist_id.6:2)s/%(playlist_id.8:2)s/%(playlist_id.10:2)s/%(playlist_id)s/%(playlist_id)s.%(ext)s" \
-o "pl_description:%(webpage_url_domain)s/playlists/%(playlist_id.2:2)s/%(playlist_id.4:2)s/%(playlist_id.6:2)s/%(playlist_id.8:2)s/%(playlist_id.10:2)s/%(playlist_id)s/%(playlist_id)s.%(ext)s" \
-o "pl_infojson:%(webpage_url_domain)s/playlists/%(playlist_id.2:2)s/%(playlist_id.4:2)s/%(playlist_id.6:2)s/%(playlist_id.8:2)s/%(playlist_id.10:2)s/%(playlist_id)s/%(playlist_id)s.%(ext)s" \
`# quality and file format` \
--extract-audio \
--remux mka \
`# thumbnails` \
--write-thumbnail \
--convert-thumbnails png \
--embed-thumbnail \
`# subtitles` \
--sub-lang "en-en,en-US,en-orig" \
--write-auto-subs \
--write-sub \
--convert-subs srt \
--embed-subs \
`# embed files` \
--embed-metadata \
--embed-info-json \
--embed-chapters \
--write-description \
--write-info-json \
--write-playlist-metafiles \
`#--write-comments` \

__regular_expression_configuration_matches='^.*\.(mka)$'

__template_name="${BASH_SOURCE[0]}"
__template_name="$(basename -- "${__template_name%%.*}")"

