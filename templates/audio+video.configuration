#!/bin/bash

# AUDIO+VIDEO QUEUE
#
# downloads audio and video files into mka/mkv container files with thumbnails, subtitles & chapters all embedded
#
#

# CONFIGURATION
__configure_download \
`# run yt-dlp with these options:…` \
yt-dlp \
--live-from-start \
--no-restrict-filenames \
--compat-options no-clean-infojson \
--output-na-placeholder "UNKNOWN_PLACEHOLDER" \
`# only last __configure_download call should use a download archive because the same .memory file is used` \
--no-download-archive \
`# show progress` \
--console-title --progress --newline --quiet \
`# output file template` \
--parse-metadata "description:(?s)(?P<meta_comment>.+)" \
-o "%(webpage_url_domain)s/audio+video/%(channel_id|uploader_id)s/%(id)s/%(id)s.%(ext)s" \
-o "%(webpage_url_domain)s/audio+video/NA/%(id)s/%(id)s.%(ext)s" \
-o "pl_video:%(webpage_url_domain)s/playlists/%(playlist_id)s/%(id)s.%(ext)s" \
-o "pl_thumbnail:%(webpage_url_domain)s/playlists/%(playlist_id)s/%(playlist_id)s.%(ext)s" \
-o "pl_description:%(webpage_url_domain)s/playlists/%(playlist_id)s/%(playlist_id)s.%(ext)s" \
-o "pl_infojson:%(webpage_url_domain)s/playlists/%(playlist_id)s/%(playlist_id)s.%(ext)s" \
`# quality and file format` \
--merge-output-format mkv --remux-video mkv \
--post-overwrites \
`# thumbnails` \
--write-thumbnail \
--convert-thumbnails png \
--embed-thumbnail \
`# subtitles` \
--sub-lang "en.*" \
--write-auto-subs \
--write-sub \
--convert-subs srt \
--embed-subs \
`# embed files` \
--embed-metadata \
--embed-info-json \
--embed-chapters \

__configure_download \
`# run yt-dlp with these options:…` \
yt-dlp \
--live-from-start \
--no-restrict-filenames \
--output-na-placeholder "UNKNOWN_PLACEHOLDER" \
`# show progress` \
--console-title --progress --newline \
`# output file template` \
--parse-metadata "description:(?s)(?P<meta_comment>.+)" \
-o "%(webpage_url_domain)s/audio+video/%(channel_id|uploader_id)s/%(id)s/%(id)s.%(ext)s" \
-o "%(webpage_url_domain)s/audio+video/%(id)s/%(id)s.%(ext)s" \
-o "pl_video:%(webpage_url_domain)s/playlists/%(playlist_id)s/%(id)s.%(ext)s" \
-o "pl_thumbnail:%(webpage_url_domain)s/playlists/%(playlist_id)s/%(playlist_id)s.%(ext)s" \
-o "pl_description:%(webpage_url_domain)s/playlists/%(playlist_id)s/%(playlist_id)s.%(ext)s" \
-o "pl_infojson:%(webpage_url_domain)s/playlists/%(playlist_id)s/%(playlist_id)s.%(ext)s" \
`# quality and file format` \
--extract-audio \
--remux mka \
`# thumbnails` \
--write-thumbnail \
--convert-thumbnails png \
--embed-thumbnail \
`# subtitles` \
--sub-lang "en.*" \
--write-auto-subs \
--write-sub \
--convert-subs srt \
--embed-subs \
`# embed files` \
--embed-metadata \
--embed-info-json \
--embed-chapters \

__regular_expression_configuration_matches='^.*\.(mkv|mka)$'

__template_name="${BASH_SOURCE[0]}"
__template_name="$(basename -- "${__template_name%%.*}")"

