#!/bin/bash

# AUDIO-BARE QUEUE
#
# downloads audio files into an mka container file with thumbnails, subtitles & chapters all embedded
#
#

# CONFIGURATION
__configure_download \
`# run yt-dlp with these options:…` \
yt-dlp \
--live-from-start \
--compat-options no-clean-infojson \
--windows-filenames \
--output-na-placeholder "UNKNOWN_PLACEHOLDER_DEBUG_REMOVE" \
`# show progress` \
--console-title --progress --newline \
`# output file template` \
--parse-metadata "description:(?s)(?P<meta_comment>.+)" \
--replace-in-metadata "title" "[＂\"]+" "_" \
--parse-metadata "%(title|)s:%(title_with_separator)s" \
--replace-in-metadata "title_with_separator" "\s-\s" " – " \
-o 'files/%(uploader_id,channel_id)s/%(title).150B/%(title_with_separator,title)s [%(id)s].%(ext)s' \

`# quality and file format` \
--extract-audio \
--remux mka \
`# thumbnails` \
--convert-thumbnails png \
--embed-thumbnail \
`# subtitles` \
--sub-lang "en.*" \
--convert-subs srt \
--embed-subs \
`# embed files` \
--embed-metadata \
--embed-info-json \
--embed-chapters \
--no-write-description \
--no-write-info-json \
--no-write-playlist-metafiles \
--no-write-comments \
