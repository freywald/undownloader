#!/bin/bash

# AUDIO+VIDEO QUEUE
#
# downloads audio and video files into mka/mkv container files with thumbnails, subtitles & chapters all embedded
#
#


# audio-codec, konvetierung hier, aber nicht zuuu genau,  wie die verzeichnisse heißen
# aber die feinheiten sollte über einen view gemacht werden z.B. über das werkzeug HOME/bin/create-view-filter-directory
# daß die json-dateien von youtube einlesen und kann einen verzeichnis-baum artist/album/ etc aufbauen kann, der nur aus links besteht, und einfacher zu ändern ist.
# foobar2000 sollte diesen als aks input bekommen
# auch der benutzer
# intern sollte eigentlich immer entweder channel|user-id/video-id/{audio, video, subtitles} ohne andere benennen sein.
# für menschen schweer zu navigieren, für eine maschine problematisch, wenn die video-metadaten in youtube geändert werden oder die konfiguration hier
# fürs händy aber: flache speicherung von dateien fürs händy, z.B. scooter - hysteria [video-id].mka ohne verzeichnis oder nach scooter [video-id]/scooter - hysteria.mka

# CONFIGURATION
__configure_download \
`# run yt-dlp with these options:…` \
yt-dlp  \
--live-from-start \
--compat-options no-clean-infojson \
--output-na-placeholder "UNKNOWN_PLACEHOLDER_DEBUG_REMOVE" \
`# only last run should use download archive` \
--no-download-archive \
`# show progress` \
--console-title --progress --newline --quiet \
`# output file template` \
--parse-metadata "description:(?s)(?P<meta_comment>.+)" \
--replace-in-metadata "title" "[＂\"]+" "_" \
--parse-metadata "%(title|)s:%(title_with_separator)s" \
--replace-in-metadata "title_with_separator" "\s-\s" " – " \
-o "%(webpage_url_domain)s/files/%(uploader_id,channel_id)s/%(title_with_separator,title)s%(display_id& [{}]|)s/%(title_with_separator,title|)s.%(ext)s" \
-o "pl_video:%(webpage_url_domain)s/playlists/%(playlist_title)s%(playlist_id& [{}]|)s/%(title)s.%(ext)s" \
-o "pl_thumbnail:%(webpage_url_domain)s/playlists/%(playlist_title)s%(playlist_id& [{}]|)s/%(title)s.%(ext)s" \
-o "pl_description:%(webpage_url_domain)s/playlists/%(playlist_title)s%(playlist_id& [{}]|)s/%(title)s.%(ext)s" \
-o "pl_infojson:%(webpage_url_domain)s/playlists/%(playlist_title)s%(playlist_id& [{}]|)s/%(title)s.%(ext)s" \
`# quality and file format` \
-f bestvideo+bestaudio \
--merge-output-format mkv --remux-video mkv \
--post-overwrites \
`# thumbnails` \
--write-thumbnail \
--convert-thumbnails png \
--embed-thumbnail \
`# subtitles` \
--sub-lang "en.*" \
--write-auto-subs \
--write-sub \
--convert-subs srt \
--embed-subs \
`# embed files` \
--embed-metadata \
--embed-info-json \
--embed-chapters \


