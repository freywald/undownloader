active_is_undownloaded() {
    local p="${1%/}"
    local part
    while [[ -n "$p" && "$p" != "/" ]]; do
        part="${p##*/}"
        if [[ "$part" == *'🔴.undownloaded'* ]]; then
            return 0
        fi
        p="${p%/*}"
        [[ "$p" == "$part" ]] && break
    done
    return 1
}

backup_matches() {
    local matches_file="$1"
    local backup i=0

    matches_backup=""
    matches_file_restore_to="$matches_file"

    [[ -f "$matches_file" ]] || return 0

    backup="$run_dir/reduplicator-matches-$__current_date.backup.txt"
    while [[ -e "$backup" || -L "$backup" ]]; do
        i=$((i + 1)) ||:
        backup="$run_dir/reduplicator-matches-${__current_date}.backup_${i}.txt"
    done

    mv -- "$matches_file" "$backup"
    matches_backup="$backup"
}

restore_matches_from_backup() {
    local dest="${1:-${matches_file_restore_to-}}"

    [[ -n "$dest" ]] || return 0

    if [[ -n "${matches_backup-}" && -e "$matches_backup" ]]; then
        mv --force -- "$matches_backup" "$dest"
    else
        rm --force -- "$dest"
    fi
}

file_stem() {
	local base="${1##*/}"
	local ext="${base##*.}"
	ext="${ext,,}"
	if is_known_media_ext "$ext"; then
		printf '%s' "${base%.*}"
	else
		printf '%s' "$base"
	fi
}

id_in_list() {
	local needle="$1"
	local id

	while IFS= read -r id; do
		[[ "$id" == "$needle" ]] && return 0
	done
	return 1
}

count_ids() {
	printf '%s\n' "$1" | grep -c -- '.' ||:
}

count_media_in_dir() {
	local dir="$1" f ext n=0
	for f in "$dir"/*; do
		[[ -f "$f" ]] || continue
		ext="${f##*.}"; ext="${ext,,}"
		is_known_media_ext "$ext" || continue
		n=$((n + 1)) ||:
	done
	printf '%s' "$n"
}

dir_name_ok_for_unit() {
	local dir="$1"
	(( $(count_media_in_dir "$dir") == 1 ))
}

is_leaf_dir() {
	local dir="$1" sub
	for sub in "$dir"/*/; do
		[[ -d "$sub" ]] && return 1
	done
	return 0
}

dir_has_video_id() {
	local dir="$1"
	local want="$2"
	local stem="$3"
	local found f json base

	[[ -d "$dir" ]] || return 1
	[[ -n "$stem" ]] || return 1

	for f in "$dir"/*; do
		[[ -f "$f" ]] || continue
		is_ignored_sidecar "$f" && continue
		base="${f##*/}"
		[[ "$base" == "${stem}."* || "$base" == "$stem" ]] || continue
		if found="$(is_match_file "$base")" && [[ "$found" == "$want" ]]; then
			return 0
		fi
		found="$(purl_id_of "$f" ||:)"
		if [[ "$found" == "$want" ]]; then
			return 0
		fi
		if [[ -z "$found" ]]; then
			if found="$(comment_id_of "$f")" && [[ "$found" == "$want" ]]; then
				return 0
			fi
		fi
	done

	for json in "$dir"/*; do
		[[ -f "$json" ]] || continue
		is_ignored_sidecar "$json" && continue
		base="${json##*/}"
		[[ "$base" == "${stem}."* || "$base" == "$stem" ]] || continue
		[[ "$base" == *.info.json || "$base" == *info.json ]] || continue
		found="$(jq -r '
			select((._type // "video") == "video")
			| select(has("entries") | not)
			| select(
				(.extractor_key // .extractor // "")
				| ascii_downcase
				| test("youtube")
			)
			| .id // empty
		' -- "$json" 2>/dev/null ||:)"
		[[ "$found" == "$want" ]] && return 0
	done

	local media_n=0 f ext
	for f in "$dir"/*; do
		[[ -f "$f" ]] || continue
		ext="${f##*.}"; ext="${ext,,}"
		is_known_media_ext "$ext" || continue
		media_n=$((media_n + 1)) ||:
	done

	if (( media_n == 1 )); then
		local dir_id=""
		dir_id="$(is_match_dir "${dir##*/}" ||:)"
		[[ "$dir_id" == "$want" ]] && return 0
	fi
	return 1
}
