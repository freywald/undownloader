#!/bin/bash

base_directory="/home/$USER/Daten/var/undownloader-reduplicator"
matches_backup=""
matches_file_restore_to=""

media_extensions=(
	"mp4" "mkv" "webm" "mov" "avi" "flv"
	"m4a" "mka" "mp3" "aac" "ogg" "opus" "wav"
	"3gp" "m4v"
	"mpg" "mpeg" "wmv" "asf" "ts" "m2ts" "mts" "vob" "ogv" "3g2" "f4v"
	"flac" "wma" "ac3" "eac3" "dts" "aiff" "aif" "ape" "oga" "weba"
)

declare -A purl_id_cache=()
declare -A purl_id_have=()

is_ignored_sidecar() {
	local base="${1##*/}"
	[[ "$base" == *.info.json.original.json ]]
}

is_known_media_ext() {
	local ext="${1,,}"
	local known

	for known in "${media_extensions[@]}"; do
		[[ "$ext" == "$known" ]] && return 0
	done
	return 1
}

log_warning() {
	printf '%s\n' "$1" >> "$warnings"
	if [[ -n "${2-}" ]]; then
		printf '%s\n' "$1" >> "$2"
	fi
}

log_error() {
	printf '%s\n' "$1"
	printf '%s\n' "$1" >> "$errors"
	if [[ -n "${2-}" ]]; then
		printf '%s\n' "$1" >> "$2"
	fi
}

mask_path() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

unmask_path() {
    local s="$1"
    local out=""
    local i=0
    local len="${#s}"
    local c n

    while (( i < len )); do
        c="${s:i:1}"
        if [[ "$c" == '\' ]]; then
            n="${s:i+1:1}"
            case "$n" in
                n)  out+=$'\n'; i=$((i + 2)) ||: ;;
                r)  out+=$'\r'; i=$((i + 2)) ||: ;;
                t)  out+=$'\t'; i=$((i + 2)) ||: ;;
                \\) out+='\';   i=$((i + 2)) ||: ;;
                *)  out+="$c";  i=$((i + 1)) ||: ;;
            esac
            continue
        fi
        out+="$c"
        i=$((i + 1)) ||:
    done
    printf '%s' "$out"
}

