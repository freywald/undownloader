detect_link_kind() {
    local hostname="$1"
    local url="$2"
    local rules_name="link_kind_${hostname}"
    local entry kind regex

    [[ -n "$hostname" && -n "$url" ]] || return 1
    declare -p "$rules_name" &>"/dev/null" || return 1

    local -n rules="$rules_name"

    for entry in "${rules[@]}"; do
        kind="${entry%%$'\t'*}"
        regex="${entry#*$'\t'}"
        [[ -n "$kind" && -n "$regex" ]] || continue
        if [[ "$url" =~ $regex ]]; then
            printf '%s' "$kind"
            return 0
        fi
    done
    return 1
}

