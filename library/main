unserialize_into_map() {
    local line="$1"
    local -n result=$2
    local order_name="${3:-}"

    if [[ -n "$order_name" ]] && declare -p "$order_name" &>"/dev/null"; then
        local -n order_array="$order_name"
    elif [[ -n "$order_name" ]]; then
        declare -ga "$order_name"
        local -n order_array="$order_name"
    fi

    local order_length=0
    if [[ ! -v order_array[@] ]]; then
        order_array=()
    fi

    order_length="${#order_array[@]}"

    declare -gA result
    result=()

    local pos=0
    local len=${#line}
    local has_keys=0
    local order_index=0

    # ====================== Parse the line ======================
    while (( pos < len )); do
         # Skip whitespace
         while (( pos < len )); do
             local c="${line:pos:1}"
             if [[ "$c" != " " && "$c" != $'\t' ]]; then break; fi
             ((pos++))||:
         done
         if (( pos >= len )); then break; fi

         local start_pos=$pos
         local key=""

         # Try to read key
         while (( pos < len )); do
             local c="${line:pos:1}"
             if [[ "$c" == "=" ]]; then
                 has_keys=1
                 key="${line:start_pos:pos-start_pos}"
                 ((pos++))||:
                 break
             fi
             if [[ "$c" == '"' ]]; then
                 break
             fi
             ((pos++))||:
         done

         # If no key was found, reset position
         if [[ $has_keys -eq 0 ]]; then
             pos=$start_pos
             key=""
         fi

         # Expect opening quote
         local c="${line:pos:1}"
         if [[ "$c" != '"' ]]; then
             ((pos++))||:
             continue
         fi
         ((pos++))||:

         # Read value
         local value=""
         local escaped=0

         while (( pos < len )); do
             local c="${line:pos:1}"
             ((pos++))||:

             if (( escaped )); then
                 case "$c" in
                     '"') value+='"' ;;
                     '\') value+='\' ;;
                     'n') value+=$'\n' ;;
                     *)   value+="\\$c" ;;
                 esac
                 escaped=0
             elif [[ "$c" == "\\" ]]; then
                 escaped=1
             elif [[ "$c" == '"' ]]; then
                 break
             else
                 value+="$c"
             fi
         done

        if [[ $has_keys -eq 0 && "$value" == *"="* ]]; then
            if [[ "$value" =~ ^([^=]+)=(.*)$ ]]; then
                key="${BASH_REMATCH[1]}"
                value="${BASH_REMATCH[2]}"
                has_keys=1
            fi
        fi

         # Assign to map
         if [[ $has_keys -eq 1 ]]; then
             # Key was present in string
             result["$key"]="$value"
             order_array+=("$key")
         else
             # No key in string → use next key from order_array
             if (( order_index >= order_length )); then
                 echo "ERROR: Not enough keys in order array for bare value at position $order_index" >&2
                 return 1
             fi
             key="${order_array[$order_index]}"
             result["$key"]="$value"
             ((order_index++))||:
         fi

         has_keys=0
     done
 }

extract_hashmap_to_locals() {
	local -n hashmap=$1
	local prefix="${2:-}"

	for key in "${!hashmap[@]}"; do
		local var_name="${prefix}${key}"
		printf -v "$var_name" '%s' "${hashmap[$key]}"
	done
}

dump_map() {
	local -n hashmap=$1
	local order_name="${2:-}"

	if [[ -n "$order_name" ]] && declare -p "$order_name" &>"/dev/null"; then
		local -n order_array="$order_name"
		for key in "${order_array[@]}"; do
			if [[ -v hashmap[$key] ]]; then
				printf '  %-12s = [%s]\n' "$key" "${hashmap[$key]}"
			fi
		done
	else
		for key in "${!hashmap[@]}"; do
			printf '  %-12s = [%s]\n' "$key" "${hashmap[$key]}"
		done
	fi
}

dump_array() {
	local -n array="$1"
	for value in "${array[@]}"; do
		printf '  %-12q \n' "$value"
	done
}
