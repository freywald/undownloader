yt_dlp_fast="--sleep-requests 0 --sleep-interval 0 --simulate --no-download-archive --no-warnings"

function log_handler() {
    printf '%s\n' "$1" >> "$HANDLER_ERROR_FILE"
}
# wrapper statuses (not from yt-dlp)
readonly YTDLP_NO_PLAYLISTS=80
readonly YTDLP_PLAYLISTS_404=81
readonly YTDLP_AGE_GATE=82
readonly YTDLP_BOT_GATE=83
readonly YTDLP_COOKIES=84
readonly YTDLP_MEMBERS=85
readonly YTDLP_PRIVATE=86
readonly YTDLP_UNAVAILABLE=87
readonly YTDLP_GEO=88
readonly YTDLP_HTTP_4XX=89
readonly YTDLP_DOWNLOAD=90
readonly YTDLP_SIGNIN=91
readonly YTDLP_NOT_JSON=92

# Match yt-dlp *errors*, not video metadata.
# Real members-only lines look like:
#   ERROR: [youtube] ID: Join this channel to get access to members-only content ...
#   ERROR: [youtube] ID: This video is available to this channel's members ...
ytdlp_classify() {
    local err_text="$1"
    local pattern code

    shift ||:
    # remaining "$@" is the yt-dlp command, for the log line

    while IFS=$'\t' read -r code pattern; do
        [[ -n "$code" ]] || continue
        if grep -Eiq -- "$pattern" <<<"$err_text"; then
            log_handler "yt-dlp status $code: $*"
            [[ -n "$err_text" ]] && log_handler "$err_text"
            return "$code"
        fi
    done <<'EOF'
80	does not have a playlists tab
81	playlists: Unable to download webpage: HTTP Error 404
82	confirm your age|age-restricted
83	sign in to confirm you.?re not a bot|not a bot
84	use --cookies-from-browser or --cookies for the authentication
85	members-only content|available to this channel'?s members
86	this video is private|private video
87	video unavailable|this video is not available
88	not available in your country|content isn.?t available
89	http error 4[0-9]{2}
90	unable to download
91	ERROR:.*sign in to
EOF

    return 0
}

ytdlp_capture() {
    local err out status=0 classified=0 err_text

    err="$(mktemp)" || return 1
    out="$("$@" 2>|"$err")" || status=$?
    err_text="$(cat -- "$err" 2>/dev/null ||:)"
    rm --force -- "$err"

    # Successful extraction can still contain "Join this channel" in description JSON.
    # Only classify when yt-dlp itself failed.
    if (( status > 0 )); then
        ytdlp_classify "$err_text" "$@" || classified=$?
        if (( classified != 0 )); then
            return "$classified"
        fi
        log_handler "yt-dlp failed ($status): $*"
        [[ -n "$err_text" ]] && log_handler "$err_text"
        [[ -n "$out" ]] && log_handler "$out"
        return "$status"
    fi

    ytdlp_out="$out"
    return 0
}

declare -g ytdlp_out=""

ytdlp_json() {
    ytdlp_out=""
    ytdlp_capture "$@" || return $?
    if ! jq -e 'type == "object" or type == "array"' >/dev/null 2>&1 <<<"$ytdlp_out"; then
        log_handler "yt-dlp not json: $*"
        log_handler "$ytdlp_out"
        return "$YTDLP_NOT_JSON"
    fi
    printf '%s' "$ytdlp_out"
    return 0
}

ytdlp_text() {
    ytdlp_out=""
    ytdlp_capture "$@" || return $?
    printf '%s' "$ytdlp_out"
    return 0
}

