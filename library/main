function get_video_data_of_url(){
	local video_url="$1"
	local cache_directory_name="$2"
	local lookup_only="${3:-false}"

	local cache_directory="$application_var_directory/playlist-cache/"
	mkdir --parents -- "$cache_directory/$cache_directory_name/" || exit 1

	local encoded_url
	encoded_url_for_filename=$(echo "$video_url" | tr '/' '_' | tr -d '\0')
	encoded_url=$(echo "$video_url" | sha1sum | cut --delimiter=' ' -f1)

	if [[ -z "$encoded_url" ]]; then
		return 1
	fi

	local length="${#encoded_url}"

	local segment_size
	if (( length < 10 )); then
		segment_size=1
	else
		segment_size=2
	fi

	local path=""
	local level=0
	local i=0
	while (( i < length && level < 5 )); do
		local chunk="${encoded_url:i:segment_size}"
		if [[ -n "$chunk" ]]; then
			path="${path}${chunk}/"
			((level++)) ||:
		fi

		((i += segment_size)) ||:
	done

	local cache_file="$cache_directory/$cache_directory_name/${path%/}/$encoded_url_for_filename.txt"

	local video_id channel_id
	if ! cache_is_valid "$cache_file" "$video_url" "$lookup_only"; then
		mapfile -d '' -t site_configuration < <(determinate_site_configuration "$video_url")

		local json
		local status=0
		json="$(ytdlp_json yt-dlp $yt_dlp_fast "${site_configuration[@]}" --dump-single-json --flat-playlist -- "$video_url")" || status=$?
        if (( status > 0 )); then
			#__error "get_video_data_of_url: %s" "$(cat -- "$handler_error_file")"
			return "$status"
        fi
        channel_id="$(jq -r '.channel_id // empty' <<< "$json")"
        if [[ -z "$channel_id" ]]; then
        	log_handler "detected channel id empty: $channel_id"
		fi

		local video_ids=()
		while IFS= read -r line; do
			if [[ -n "$line" ]]; then
				 video_ids+=("$line")
			fi
		done < <(jq -r 'if (.entries? | type) == "array" then .entries[].id else .id end // ""' <<< "$json")

		mkdir --parents -- "$(dirname -- "$cache_file")" || exit 1
		{
			echo "$channel_id"
			printf '%s\n' "${video_ids[@]}"
		} >| "$cache_file"
	fi

	mapfile -t lines < "$cache_file"
	if (( ${#lines[@]} < 2 )); then
		rm --force -- "$cache_file"
		return 1
	fi

	echo "$cache_file"
	return 0
}

handle_youtube_url() {
    local -n url_array_reference=$1
    local parameter_url="$2"
    local parameter_url_unsanitized="$3"
    local possibly_original_playlist_id="$4"

	__verbose "Looking for a playlist URL for the youtube video from the same channel %s" "$parameter_url"
	queue_suffix=""

    local url_list
    url_list="$(mktemp)" || return 1

	local status
    __handle_youtube_url_main "$parameter_url" "$possibly_original_playlist_id" >| "$url_list"
    status=$?

    if (( status == 0 )); then
    	readarray -t url_array_reference < "$url_list"
		local channel_id="${url_array_reference[0]:-}"
		url_array_reference=("${url_array_reference[@]:1}")
		url_array_length="${#url_array_reference[@]}"

		if (( url_array_length == 0 )); then
			:
		elif (( url_array_length == 1 )); then
			if [[ "${url_array_reference[0]}" != "$parameter_url" ]]; then
				url_changed=true
				__verbose "New video URL %s" "$parameter_url"
			fi
		else
			queue_suffix="$channel_id"
		fi
	else
		__warn "URL %s failed!" "$parameter_url"

		if [[ -f "$known_failed_file_log" ]] && grep --quiet -- "^$parameter_url_unsanitized$" "$known_failed_file_log" > "/dev/null"; then
			__warn "URL %s IS A KNOWN FAIL!" "$parameter_url"
		fi

		echo "$parameter_url_unsanitized" >> "$current_fails_file_log"

		if [[ -f "$known_failed_file_log" && -f "$failed_file_log" ]] && ! grep --quiet -- "^$parameter_url_unsanitized$" "$known_failed_file_log" > "/dev/null" && ! grep --quiet -- "^$parameter_url_unsanitized$" "$failed_file_log" > "/dev/null"; then
			echo "$parameter_url_unsanitized" >> "$failed_file_log"
		elif [[ ! -f "$known_failed_file_log" ]]; then
			if [[ -f "$failed_file_log" ]]; then
				if ! grep --quiet -- "^$parameter_url_unsanitized$" "$failed_file_log" > "/dev/null"; then
					echo "$parameter_url_unsanitized" >> "$failed_file_log"
				fi
			elif [[ ! -f "$failed_file_log" ]]; then
				echo "$parameter_url_unsanitized" >> "$failed_file_log"
			fi
		fi

		return 0
	fi
}

function __handle_youtube_url_main(){
	local video_url="$1"
	local possibly_original_playlist_id="$2"

	local cache_directory="$application_var_directory/playlist-cache/"
	mkdir --parents -- "$cache_directory/channel-playlists/" || exit 1
	mkdir --parents -- "$cache_directory/channel-videos/" || exit 1
	mkdir --parents -- "$cache_directory/playlists/" || exit 1

	local is_channel=false channel_id=""

	if [[ "$video_url" =~ /@([a-zA-Z0-9_-]+) ]]; then
		is_channel=true

		mapfile -d '' -t site_configuration < <(determinate_site_configuration "$video_url")
		local json
		local status=0
		json="$(ytdlp_json yt-dlp $yt_dlp_fast "${site_configuration[@]}" --dump-single-json --flat-playlist --playlist-end 1 -- "$video_url")" || status=$?

        if (( status > 0 )); then
			(exit "$status")
        fi

		channel_id="$(jq -r '.channel_id // ""' <<< "$json")"
	elif [[ "$video_url" =~ /channel/([A-Za-z0-9_-]+) ]]; then
		is_channel=true
		channel_id="${BASH_REMATCH[1]}"
	fi

	local playlist_tab_exists
	playlist_tab_exists=2

	if [[ -n "$channel_id" ]]; then
		mapfile -d '' -t site_configuration < <(determinate_site_configuration "https://www.youtube.com/channel/${channel_id}/playlists")
		ytdlp_text yt-dlp $yt_dlp_fast "${site_configuration[@]}" --flat-playlist --playlist-end 1 --print "id" -- "https://www.youtube.com/channel/${channel_id}/playlists"
		status=$?

		if (( status == YTDLP_NO_PLAYLISTS || status == YTDLP_PLAYLISTS_404 )); then
			playlist_tab_exists=0
		elif (( status == 0 )); then
			playlist_tab_exists=1
		elif (( status > 0 )); then
			#__error "%s" "$(cat -- "$handler_error_file")"
			#return "$status"
			(exit "$status")
		fi
    fi

	if $is_channel; then
		if [[ -z "$channel_id" ]]; then
			return 1
		fi

		local channel_videos_cache
		local c1="${channel_id:2:2}"
		local c2="${channel_id:4:2}"
		local c3="${channel_id:6:2}"
		local c4="${channel_id:8:2}"
		local c5="${channel_id:10:2}"
		channel_videos_cache="$cache_directory/channel-videos/${c1}/${c2}/${c3}/${c4}/${c5}/${channel_id}_videos.txt"
		local channel_url
		channel_url="https://www.youtube.com/channel/${channel_id}"
		if cache_is_valid "$channel_videos_cache" "$channel_url"; then
			videos="$(cat -- "$channel_videos_cache")"
		else
			mapfile -d '' -t site_configuration < <(determinate_site_configuration "$channel_url")
			videos="$(ytdlp_text yt-dlp $yt_dlp_fast "${site_configuration[@]}" --flat-playlist --print "id" -- "$channel_url")"
            status=$?
            if (( status > 0 )); then
                 (exit "$status")
            fi

			mkdir --parents -- "$(dirname -- "$channel_videos_cache")" || exit 1
			printf '%s\n' "$videos" >| "$channel_videos_cache"
		fi

		echo "$channel_id"

		local video_id
		local fail_status=0
		local count=0
		local all_videos_failed=true
		while IFS= read -r video_id; do
			[[ -z "$video_id" ]] && continue
			((count++))
			local single_url="https://www.youtube.com/watch?v=${video_id}"
			if ! youtube_get_combined_playlist_video_url "$playlist_tab_exists" "$single_url" "$possibly_original_playlist_id"; then
				fail_status=$?
			else
				all_videos_failed=false
			fi
		done < "$channel_videos_cache"
		if ((count==0)); then
			fail_status=1
		elif ((count==1)) || ( ((count>1)) && $all_videos_failed ); then
			:
		else
			fail_status=0
		fi

		return "$fail_status"
	fi

	echo "$channel_id"

	local status=0
	youtube_get_combined_playlist_video_url "$playlist_tab_exists" "$video_url" "$possibly_original_playlist_id" || status=$?
	return "$status"
}

#@ todo fixme if url is new and  playlist cache exists or channel cache the cache is invalid automatically!

cache_is_valid() {
    local file="${1-}"
    local url="${2:-}"
    local lookup_only="${3:-false}"

    [[ -n "$file" && -f "$file" ]] || return 1
    
    $lookup_only && return 0

    local cache_ttl=3600

	hostname="$(get_hostname_by_url "$url")" || hostname=""
	link_kind="$(detect_link_kind "$hostname" "$url")" || link_kind=""

    if $clean_outdated_cache; then
    	if [[ "$link_kind" == "video" ]]; then
			if $video_cache_expires; then
				cache_ttl="$cache_video_time_to_live" # 1 year
			else
				return 0 # cache does not invalidate
			fi
		else
			cache_ttl="$cache_other_time_to_live" # 1 hour
		fi
	else
		if [[ "$link_kind" == "video" ]]; then
			return 0 # cache does not invalidate
		fi
		if $other_cache_expires; then
			cache_ttl="$cache_other_time_to_live" # 1 hour
		fi

		return 0 # cache does not invalidate
	fi

    [[ -n "${cache_ttl-}" ]] || return 1

	local mtime
    mtime="$(stat -c "%Y" -- "$file")" || return 1

    local now
    now="$(date "+%s")" || return 1

    (( now - mtime < cache_ttl ))
}

function youtube_get_combined_playlist_video_url(){
	local playlist_tab_exists="$1"
	local video_url="$2"
	local possibly_original_playlist_id="$3"

	local cache_directory="$application_var_directory/playlist-cache/"

	if [[ "$video_url" =~ v=([a-zA-Z0-9_-]+) ]]; then
		video_id="${BASH_REMATCH[1]}"
	elif [[ "$video_url" =~ playlist\?list=([a-zA-Z0-9_-]+) ]]; then
		echo "$video_url"
		return 0
	else
		__error "youtube_get_combined_playlist_video_url::should not happen |URL=%s" "$video_url"
		local_exit_failsafe

		return 1
	fi

	if [[ -n "$possibly_original_playlist_id" ]]; then
    	echo "https://youtube.com/watch?v=${video_id}&list=$possibly_original_playlist_id"
    	return 0
    fi

	log_handler "Looking up: $video_url"

	local video_id channel_id
	local cache_file

	local status=0
	cache_file="$(get_video_data_of_url "$video_url" "urls")" || status=$?

    if (( status == 0 )); then
        :
    elif (( status >= 80 && status <= 92 )); then
        return "$status"
    else
        __error "youtube_get_combined_playlist_video_url::should not happen 2=%s STATUS=%s |URL=%s" "$ytdlp_out" "$status" "$video_url"
        local_exit_failsafe
        return 1
    fi

#	if ! cache_file="$(get_video_data_of_url "$video_url" "urls")" || status=$?; then
#		    if (( status >= 80 && status <= 92 )); then
#				__error "URL PROBLEM=%s | URL=%s" "$ytdlp_out" "$video_url"
#				local_exit_failsafe
#            elif (( status > 0 )); then
#				__error "youtube_get_combined_playlist_video_url::should not happen 2 |URL=%s" "$video_url"
#				local_exit_failsafe
#            fi
#
#		return 1
#	fi

	mapfile -t lines < "$cache_file"

	local i=0
	channel_id=""
	video_id=""
	for line in "${lines[@]}"; do
		if (( i == 0 )); then
			channel_id="$line"
		elif [[ -n "$line" ]]; then
			video_id="$line"
		fi
		(( i++ )) ||:
	done

	if [[ -z "$channel_id" || -z "$video_id" ]]; then
		file1="$(cat -- "$cache_file")"
		rm --force -- "$cache_file"

		file2="$(cat -- "$HANDLER_ERROR_FILE")"
		echo -n >| "$HANDLER_ERROR_FILE"

		__error "Playlist cache was defect for URL=%s PLAYLIST_ID=%s\nCACHE FILE=%s\nHANDLER_LOG=%s" "$video_url" "$possibly_original_playlist_id" "$file1" "$file2"
		local_exit_failsafe

		return 1
	fi

	if (( playlist_tab_exists == 0 )); then
		echo "https://youtube.com/watch?v=${video_id}"
		return 0
	fi

	local playlists
	local c1="${channel_id:2:2}"
	local c2="${channel_id:4:2}"
	local c3="${channel_id:6:2}"
	local c4="${channel_id:8:2}"
	local c5="${channel_id:10:2}"
	local playlists_cache
	playlists_cache="$cache_directory/channel-playlists/${c1}/${c2}/${c3}/${c4}/${c5}/${channel_id}.txt"
	local playlists_url
	playlists_url="https://www.youtube.com/channel/${channel_id}/playlists"
	if cache_is_valid "$playlists_cache" "$playlists_url"; then
		playlists="$(cat -- "$playlists_cache")"
	else
		mapfile -d '' -t site_configuration < <(determinate_site_configuration "$playlists_url")
		playlists="$(ytdlp_text yt-dlp $yt_dlp_fast "${site_configuration[@]}" --flat-playlist --print "id" -- "$playlists_url")"
        status=$?
		if (( status == YTDLP_NO_PLAYLISTS || status == YTDLP_PLAYLISTS_404 )); then
			playlist_tab_exists=0
			echo "$video_url"
			return 0
		elif (( status > 0 )); then
			(exit "$status")
		fi

		mkdir --parents -- "$(dirname -- "$playlists_cache")" || exit 1
		printf '%s\n' "$playlists" >| "$playlists_cache"
	fi

	local found_playlist_id=""

	local playlist_id=""
	while IFS='|' read -r playlist_id; do
		[[ -z "$playlist_id" ]] && continue

		local playlist_data
		local p1="${channel_id:2:2}"
		local p2="${channel_id:4:2}"
		local p3="${channel_id:6:2}"
		local p4="${channel_id:8:2}"
		local p5="${channel_id:10:2}"
		playlist_cache="$cache_directory/playlists/${p1}/${p2}/${p3}/${p4}/${p5}/${channel_id}/${playlist_id}.txt"
		local playlist_url
		playlist_url="https://www.youtube.com/playlist?list=$playlist_id"
		if cache_is_valid "$playlist_cache" "$playlist_url"; then
			playlist_data="$(cat -- "$playlist_cache")"
		else
			mapfile -d '' -t site_configuration < <(determinate_site_configuration "$playlist_url")
			playlist_data="$(ytdlp_text yt-dlp $yt_dlp_fast "${site_configuration[@]}" --flat-playlist --print "id" -- "$playlist_url")"
			status=$?
			if (( status > 0 )); then
				(exit "$status")
			fi

			mkdir --parents -- "$(dirname -- "$playlist_cache")" || exit 1
			printf '%s\n' "$playlist_data" >| "$playlist_cache"
		fi

		if echo "$playlist_data" | grep --quiet --fixed-strings --line-regexp -- "$video_id" > "/dev/null"; then
			found_playlist_id="$playlist_id"
			break
		fi
	done <<< "$playlists"

	if [[ -n "$found_playlist_id" ]]; then
		echo "https://youtube.com/watch?v=${video_id}&list=${found_playlist_id}"
	else
		echo "https://youtube.com/watch?v=${video_id}"
	fi
}

escape_for_double_quotes() {
	local value="$1"
	value="${value//\\/\\\\}"      # \  → \\
	value="${value//\"/\\\"}"      # "  → \"
	value="${value//$'\n'/\\n}"    # newline → \n
	printf '%s' "$value"
}

unescape_for_double_quotes() {
	local value="$1"
	value="${value//\\n/$'\n'}"    # \n  → actual newline
	value="${value//\\\"/\"}"      # \"  → "
	value="${value//\\\\/\\}"      # \\  → \
	printf '%s' "$value"
}

serialize_map_into_arguments() {
	local -n hashmap=$1
	local order_name="${2:-}"

	local output=""

	if [[ -n "$order_name" ]] && declare -p "$order_name" &>"/dev/null"; then
		# Use provided order array (preserves original order)
		local -n order_array="$order_name"
		for key in "${order_array[@]}"; do
			if [[ -v hashmap[$key] ]]; then
				local value="${hashmap[$key]}"
				local escaped
				escaped="$(escape_for_double_quotes "$value")"
				output+="\"${escaped}\" "
			fi
		done
	else
		# No order array provided → use default (unordered) iteration
		for key in "${!hashmap[@]}"; do
			local value="${hashmap[$key]}"
			local escaped
			escaped="$(escape_for_double_quotes "$value")"
			output+="\"${escaped}\" "
		done
	fi

	printf '%s' "${output% }"
}

serialize_array_into_arguments() {
	local output=""

	for pair in "$@"; do
		local value="$pair"
		local escaped
		escaped="$(escape_for_double_quotes "$value")"
		output+="\"${escaped}\" "
	done

	printf '%s' "${output% }"
}

serialize_array() {
	local output=""

	for pair in "$@"; do
		if [[ "$pair" =~ ^([^=]+)=(.*)$ ]]; then
			local key="${BASH_REMATCH[1]}"
			local value="${BASH_REMATCH[2]}"

			local escaped
			escaped="$(escape_for_double_quotes "$value")"
			output+="${key}=\"${escaped}\" "
		else
			__warn "Warning: Invalid pair (no '='): %s" "$pair"
		fi
	done

	printf '%s' "${output% }"
}

serialize_into_key_value_pairs_todo() {
	local output=""
	local order_name="${2:-}"

	if [[ -n "$order_name" ]] && declare -p "$order_name" &>"/dev/null"; then
		# Use provided order array
		local -n order_array="$order_name"
		for pair in "${order_array[@]}"; do
			if [[ "$pair" =~ ^([^=]+)=(.*)$ ]]; then
				local key="${BASH_REMATCH[1]}"
				local value="${BASH_REMATCH[2]}"

				local escaped
				escaped="$(escape_for_double_quotes "$value")"
				output+="${key}=\"${escaped}\" "
			else
				__warn "Warning: Invalid pair (no '='): %s" "$pair"
			fi
		done
	else
		# Default behavior: process arguments in the order they were passed
		for pair in "$@"; do
			if [[ "$pair" =~ ^([^=]+)=(.*)$ ]]; then
				local key="${BASH_REMATCH[1]}"
				local value="${BASH_REMATCH[2]}"

				local escaped
				escaped="$(escape_for_double_quotes "$value")"
				output+="${key}=\"${escaped}\" "
			else
				__warn "Warning: Invalid pair (no '='): %s" "$pair"
			fi
		done
	fi

	printf '%s' "${output% }"
}

serialize_map() {
	local -n hashmap=$1
	local order_name="${2:-}"          # Name of the order array (optional)

	local output=""

	if [[ -n "$order_name" ]] && declare -p "$order_name" &>"/dev/null"; then
		# Use provided order array (preserves original order)
		local -n order_array="$order_name"
		for key in "${order_array[@]}"; do
			if [[ -v hashmap[$key] ]]; then
				local value="${hashmap[$key]}"
				local escaped
				escaped="$(escape_for_double_quotes "$value")"
				output+="${key}=\"${escaped}\" "
			fi
		done
	else
		# No order array provided → use default (unordered) iteration
		for key in "${!hashmap[@]}"; do
			local value="${hashmap[$key]}"
			local escaped
			escaped="$(escape_for_double_quotes "$value")"
			output+="${key}=\"${escaped}\" "
		done
	fi

	printf '%s' "${output% }"   # remove trailing space
}

