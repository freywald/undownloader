host_of() {
    local h="${1#*://}"
    h="${h%%/*}"
    h="${h%%:*}"
    h="${h%%\?*}"
    h="${h%%#*}"
    printf '%s' "${h,,}"
}

get_hostname_by_url() {
    local host re
    host="$(host_of "$1")"
    [[ -n "$host" ]] || return 1

    for re in "${!host_match_name[@]}"; do
        if [[ "$host" =~ $re ]]; then
            printf '%s' "${host_match_name[$re]}"
            return 0
        fi
    done

    return 1
}

site_args() {
    local key="${1-}"
    local spec=""
    local part

    [[ -n "$key" ]] || return 0
    spec="${base_configuration_site[$key]-}"
    [[ -n "$spec" ]] || return 0

    while [[ -n "$spec" ]]; do
        part="${spec%%;*}"
        if [[ "$spec" == *';'* ]]; then
            spec="${spec#*;}"
        else
            spec=""
        fi
        part="${part#"${part%%[![:space:]]*}"}"
        part="${part%"${part##*[![:space:]]}"}"
        [[ -n "$part" ]] && printf '%s\0' "$part"
    done
}

determinate_site_configuration() {
    local host
    hostname="$(get_hostname_by_url "$1")" || hostname=""
    printf '%s\0' "${base_configuration[@]}"
    [[ -n "$hostname" ]] || return 0
    site_args "$hostname"
}

function handle_source_selector(){
	local file_selector="$1"
	local view_name="${2:-}"

	#@todo tests
	#file_selector="audio:./file/a.b.c.vid.sources"
	#file_selector="audio:/file/a.b.c.vid.sources"
	#file_selector="audio:a.b.c.vid.sources"
	#file_selector="a.b.c.vid.sources"
	#file_selector="./gg/a.sources"
	#file_selector="a.sources"
	#file_selector="./gg/a.VID.sources"
	#file_selector="a.VID.sources"
	#file_selector="a.b.c.video.sources"
	#file_selector="a.video.sources"

	__debug "SELECTOR: $file_selector"

	file_is_selector=false
	if [[ "$file_selector" =~ : ]]; then
		template_name="${file_selector%:*}"
		file_selector="${file_selector#*:}"
		file_is_selector=true
	fi

	sources_full_file_path="$file_selector"
	sources_file_name="$(basename -- "$file_selector")"

	if [[ -f "$application_var_directory/sources/$sources_file_name" ]]; then
		sources_full_file_path="$application_var_directory/sources/$sources_file_name"
		sources_file="$(realpath --quiet -- "$sources_full_file_path")"
		if [[ -z "$view_name" ]]; then
			view_name="$(basename -- "$sources_file")"
			view_name="${view_name%%.*}"
		fi
		base_directory="$(dirname -- "$sources_file")"
		cd -- "$base_directory" || exit 1
	fi

	queue_name="${sources_file_name%.*}"

	if ! $file_is_selector; then
		template_name="${queue_name##*.}"
		if [[ "$queue_name" == "$template_name" ]]; then
			template_name="$default_template_name"
		fi
		if [[ -z "$template_name" ]]; then
			template_name="$default_template_name"
		fi
		unit_name="${queue_name%.*}"
	else
		unit_name="$queue_name"
	fi

	if [[ -z "$view_name" ]]; then
		view_name="$unit_name"
	fi

	__debug "view_name=$view_name"
	__debug "unit_name=$unit_name"
	__debug "template_name=$template_name"
	__debug "sources_full_file_path=$sources_full_file_path"
	__debug "sources_file_name=$sources_file_name"
	__debug "queue_name=$queue_name"

	base_directory="$PWD/🔴.undownloaded"

	if [[ -n "$target_directory" ]]; then
		download_directory="$target_directory/"
	else
		download_directory="$base_directory/files/"
	fi
	__debug "PWD=$PWD"
	__debug "base_directory=$base_directory"
	__debug "download_directory=$download_directory"

	sources_full_file_real_path="$sources_full_file_path"

	if [[ "${sources_full_file_path:0:1}" != "/" ]]; then
		sources_full_file_real_path="$(realpath --quiet -- "$__current_directory/$sources_full_file_real_path")"
	else
		sources_full_file_real_path="$(realpath --quiet -- "$sources_full_file_real_path")"
	fi

	__debug "SELECTOR: $file_selector"
}

function sanitize_url() {
    local url="$1"
    local video_id="" playlist_id=""

    url="${url#"${url%%[![:space:]]*}"}"
    url="${url%"${url##*[![:space:]]}"}"

    url="${url#http://}"
    url="${url#https://}"
    url="https://${url}"

    url="${url//https:\/\/www./https:\/\/}"
    url="${url//https:\/\/m./https:\/\/}"
    url="${url//https:\/\/music./https:\/\/}"
    url="${url//https:\/\/studio./https:\/\/}"

    if [[ "$url" =~ ^https://youtu\.be/([A-Za-z0-9_-]+) ]]; then
        url="https://youtube.com/watch?v=${BASH_REMATCH[1]}"
    fi

    if [[ "$1" =~ [?\&]list=([A-Za-z0-9_-]+) ]]; then
        playlist_id="${BASH_REMATCH[1]}"
    fi

    if [[ "$url" =~ ^https://youtube\.com/watch\? ]]; then
        video_id=""
        [[ "$url" =~ [?\&]v=([A-Za-z0-9_-]+) ]] && video_id="${BASH_REMATCH[1]}"
        if [[ -n "$video_id" ]]; then
            url="https://youtube.com/watch?v=${video_id}"
        fi
    fi

    while [[ "$url" == */ ]]; do
        url="${url%/}"
    done

    printf '%s\n' "$url"
    printf '%s\n' "$playlist_id"
}

function is_url_in_memory_file(){
	local video_url="$1"
	local memory_file="$2"

	local lookup_only=true

	local status
	cache_file="$(get_video_data_of_url "$video_url" "urls" "$lookup_only")"
    status=$?

    if (( status > 0 )); then
		return 2
    fi

	mapfile -t lines < "$cache_file"

	local i=0
	local incomplete=false
	for line in "${lines[@]}"; do
		if (( i > 0 )); then # skips channel id at position 0
			local video_id
			video_id="$line"
			if ! grep --quiet --extended-regexp -- "^([^\ ]+) ($video_id)$" "$memory_file" > "/dev/null"; then
				incomplete=true
			fi
		fi
		(( i++ )) ||:
	done

	$incomplete && return 1

	return 0
}
