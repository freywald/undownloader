if [[ -n "$from_sources_file" ]]; then
	if (( ${#given_queues[@]} != 0 )); then
		echo>&2 "ERROR: use option '--from-sources-file' only to download from a file OR supply existing queues [ supplied were: ${given_queues[*]} ]"
		exit 1
	fi

	handle_source_list "$from_sources_file"
elif (( ${#given_queues[@]} != 0 )); then
	echo "running the queues '${given_queues[*]}'…"

	for queue_file in "${given_queues[@]}"; do
		handle_queue "$queue_file"
	done
else
	echo "running the default queues '${default_queues[*]}'…"
	__press_any_key_to_continue

	run_default_queues
fi
