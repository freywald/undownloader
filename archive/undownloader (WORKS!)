		trap "[[ ! -e \"$local_queue\" && -e \"../archive/${local_queue}.$__current_date.backup\" ]] && mkdir --parents -- \"../archive\" && mv -- \"../archive/${local_queue}.$__current_date.backup\" \"$local_queue\" && echo -e \"\\n\\nAborted. Queue file '$local_queue' was restored from backup!\"" EXIT QUIT

		[[ -e "$local_queue" ]] && mkdir --parents -- "../archive" && mv -- "$local_queue" "../archive/${local_queue}.$__current_date.backup"
