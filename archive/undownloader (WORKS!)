		mkdir --parents "archive" || exit 1
		remote_download_archive="archive/${sources_file_name}.$__current_date.memory"

		if [[ -f "$local_download_index" ]]; then
			cp -- "$local_download_index" "$remote_download_archive"
		fi
	fi
