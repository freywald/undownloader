#!/bin/bash

#tag each download with source file unit name
#music.video-not-interesting.audio+video => video-not-interesting
#and via comment in sources linklist
## categorization=video-not-interesting (from sources + unit name + other sources)
#then in the view, allow {{category=video-not-interesting}} (only from sources) to filter music
#or {{unit=video-not-interesting}} (only from file name)

source -- "$(realpath "$(dirname -- "${BASH_SOURCE[-1]}")/../")/library/base" || exit 1
__set_script_path
__enable_error_handler
function local_exit_failsafe() { __exit_failsafe; exit 1; }

HANDLER_ERROR_FILE="$(mktemp)" || exit 1
export HANDLER_ERROR_FILE

source -- "$__script_path/library/main" || exit 1

#parse commandline options
getopt --test > "/dev/null" &&:
if (( $? != 4 )); then
	echo>&2 "Error: 'getopt --test' failed in this environment!"
	exit 1
fi

print_sources_files=false
update_all_sources=false
mode=""
forwarded_parameters=()
given_files=()

declare -gA attached_queues
attached_queues=()

long_options="view,print-sources,force-view-update,force-download,filtered-queue,fetch-source-updates,verbose,quiet,debug,simulate,fetch,update,fast-update,reset,forget-downloads,ban-evasion,comments,all,update-all,from-sources-file::,target-directory::"
original_program_arguments=("$@")

parsed_options2=$(getopt --options="pau::" --longoptions="$long_options" --name "$0" -- "$@") ||__expression_may_fail
# shellcheck disable=SC2128

eval "set -- $parsed_options2"
parsed_options=("$@")
set -- "${original_program_arguments[@]}"

input_parameters=()
len="${#parsed_options[@]}"
i=0
while (( i<len )); do
	case "${parsed_options[i]}" in
		--all)
			update_all_sources=true
			;;
		--view)
			run_view=true
			;;
		--print-sources | -p)
			print_sources_files=true
			;;
		--force-view-update)
			force_view_update=true
			;;
		--update-all)
			force_view_update=true
			update_all_sources=true
			;;
		--comments)
			write_comments=true
			;;
		--ban-evasion)
			ban_evasion=true
			;;
		--simulate)
			simulate=true
			;;
		--fetch) # fetch = creates a new input queue from sources. Without, the input queue, if it exists, won't be updated from source. If there is no input queue yet, it is always created even without --fetch. Keeps reading from outdated cache entries for fast undownloads.
			[[ -n "$mode" ]] && __error "--fetch is exclusive with specified argument --%s" "$mode"
			mode="fetch"
			fetch=true
			#filtered_queue=false #default, can be additionally applied
			ignore_memory=false #default
			clean_outdated_cache=false #default
			video_cache_expires=false #default
			other_cache_expires=false #default
			;;
		--fetch-source-updates | -a) # like fetch, but filters queue strongly by previous downloads and tries to pull in the updates of sources fast. Keeps reading from outdated cache entries for fast undownloads.
			[[ -n "$mode" ]] && __error "--fetch-source-updates is exclusive with specified argument --%s" "$mode"
			mode="fetch-source-updates"
			fetch=true
			filtered_queue=true
			ignore_memory=false #default
			clean_outdated_cache=false #default
			video_cache_expires=false #default
			other_cache_expires=true
			#forwarded_parameters+=( "--match-filter=!is_live" )
			;;
		--update) # like fetch, additionally it continues or retries previous downloads and cleans outdated cache entries
			[[ -n "$mode" ]] && __error "--update is exclusive with specified argument --%s" "$mode"
			mode="update"
			fetch=true
			#filtered_queue=false #default, can be additionally applied
			ignore_memory=true
			clean_outdated_cache=true
			video_cache_expires=false #default
			other_cache_expires=false #default
			;;
		--fast-update | -u) # like update, additionally it filters the queue strongly by previous downloads to speed up the undownloads.
			[[ -n "$mode" ]] && __error "--fast-update is exclusive with specified argument --%s" "$mode"
			mode="fast-update"
			fetch=true
			filtered_queue=true
			ignore_memory=true
			clean_outdated_cache=true
			video_cache_expires=false #default
			other_cache_expires=false #default
			;;
		--reset)
			[[ -n "$mode" ]] && __error "--reset is exclusive with specified argument --%s" "$mode"
			mode="reset" # like update, additionally it removes all memory of previous downloads and cleans outdated cache entries.
			fetch=true
			#filtered_queue=false #default, can be additionally applied, but doesn't seem to make much sense
			ignore_memory=true
			clean_outdated_cache=true
			video_cache_expires=true
			other_cache_expires=false #default
			forget_downloads=true
			;;
		--force-download)
			force_download=true
			;;
		--forget-downloads)
			forget_downloads=true
			;;
		--filtered-queue)
			filtered_queue=true
			;;
		--quiet)
			__quiet=true
			forwarded_parameters+=( "--quiet" )
			;;
		--verbose)
			__verbose=true
			;;
		--debug)
			__debug=true
			;;
		--from-sources-file)
			from_sources_file="${parsed_options[i+1]}"
			if [[ -z "$from_sources_file" ]]; then
				__error "--from-sources-file must have a value."
				local_exit_failsafe
			fi
			((i++)) ||__expression_may_fail
			;;
		--target-directory)
			target_directory="${parsed_options[i+1]}"
			if [[ -z "$target_directory" ]]; then
				__error "--target-directory must have a value."
				local_exit_failsafe
			fi
			((i++)) ||__expression_may_fail
			;;
		--)
			;;
		*)
			if [[ -n "${parsed_options[i]}" ]]; then
				input_parameters+=("${parsed_options[i]}")
			fi
			;;
	esac
	((i++)) ||__expression_may_fail
done

if $run_view; then
	undownloader-view "$@"
	exit 0
fi

set -- "${input_parameters[@]}"

# remove current program argument $1 from $original_program_arguments
new_array=()
index_removed=0
for parameter in "${original_program_arguments[@]}"; do
	if [[ "${parameter:0:1}" != "-" && "${parameter:1:1}" != "-" && $index_removed == 0 ]]; then
		index_removed=1

		continue
	fi
	new_array+=("$parameter")
done
original_program_arguments=("${new_array[@]}")
#original_program_arguments+=("--non-cli")

__debug "original_program_arguments=%s" "${original_program_arguments[*]}"

forwardable_parameter="rsync-options"
#ignore_arguments=("--non-cli")
ignore_arguments=("")

	input_not_parsed=()
	for argument in "${original_program_arguments[@]}"; do
		name="${argument%%=*}"
		value="${argument#*=}"
		not_done=true

		if $not_done && [[ "--$forwardable_parameter" == "$name" ]]; then
			if [[ "${name:0:2}" == "--" ]]; then
				forwarded_parameters+=( "$argument" )
				not_done=false
			fi
		fi

		if $not_done && ! __array_contains "$name" "${parsed_options[@]}" && ! __array_contains "$name" "${ignore_arguments[@]}"; then
			if [[ "${argument:0:1}" == "-" && "${argument:1:1}" != "-" ]]; then
				forwarded_parameters+=( "$argument" )
			else
				#input_not_parsed+=( "$argument" )
				forwarded_parameters+=( "$argument" )
			fi
			not_done=false
		fi
	done

	if (( ${#input_not_parsed[@]} > 0 )); then
			echo>&2 -e "ERROR: unknown parameters:\n"
			for queue_configuration_option in "${input_not_parsed[@]}"; do
				echo>&2 -e "\t* $queue_configuration_option"
			done
		exit 1
	fi

__debug "forwarded_parameters=%s" "${forwarded_parameters[*]}"

download_archive=""

if [[ "$force_download" == "true" ]]; then
	force_download=true
else
	force_download=false
fi
if [[ "$simulate" == "true" ]]; then
	simulate=true
else
	simulate=false
fi
if [[ "$fetch" == "true" ]]; then
	fetch=true
else
	fetch=false
fi
if [[ "$forget_downloads" == "true" ]]; then
	forget_downloads=true
else
	forget_downloads=false
fi
if $__verbose && $__quiet; then
	__error "ERROR! Program options '--verbose' and '--quiet' are mutually exclusive."
	local_exit_failsafe
fi

if $forget_downloads && $force_download; then
	__error "ERROR! Program options '--forget-downloads' and '--force-download' are mutually exclusive."
	local_exit_failsafe
fi

if [[ -n "$from_sources_file" ]]; then
	given_files+=("$from_sources_file")
fi

if $update_all_sources; then
	given_files=( "./"*".sources" )
elif (( $# == 0 )); then
	if [[ -z "$from_sources_file" ]]; then
		routes_files=( "./"*".sources" )
		if (( ${#routes_files[@]} == 0 )); then
			__error "ERROR: No route definition file found! (search expression: *.sources)"
			local_exit_failsafe

		elif (( ${#routes_files[@]} == 1 )); then
			routes_file="${routes_files[0]}"
		else
			PS3="Which route file shall be used?"
			routes_file="$from_sources_file"

			if [[ -z "$routes_file" ]]; then
				select name in "${routes_files[@]}"; do
					for reply in $REPLY; do
						if [[ "$reply" =~ ^[1-9]+[0-9]*$ ]]; then
							if (( ${#routes_files[@]} <= reply-1 )); then
								continue
							fi

							routes_file="${routes_files[reply-1]}"
							if [[ -n "$routes_file" ]]; then
								 break 2
							fi
						fi
					done
				done
			fi
		fi
	else
		routes_file="$from_sources_file"
	fi

	if [[ ! -f "$routes_file" ]]; then
		__error "ERROR: route definition file '$routes_file' NOT found!"

		local_exit_failsafe
	fi

	if [[ -n "$routes_file" ]]; then
        given_files+=("$routes_file")
	fi
fi

trap 'echo -e "\n\n▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔\nCaught SIGNINT/CTR+C. Program aborted.\n\n▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔\n";if [[ -s "$queue_failed_items_log_file" || -s "$failed_file_log" ]]; then list_failed_downloads; fi;echo -e "\n\n";exit 1' SIGINT

function __configure_download() {
	# linearized array data with arbitrary wideness
	queue_configuration_options+=("$@")
	queue_configuration_options_wideness+=($#)
	((queue_configuration_options_count++)) ||__expression_may_fail
}

function __download_urls() {
	data+=("$@")
}

function list_failed_downloads() {
	known_to_fail=()

	if [[ -s "$queue_failed_items_log_file" || -s "$failed_file_log" ]]; then
		echo -e "██  List of failed items:"
	else
		echo -e "██  List of failed items:\t\tNONE"
	fi

	if [[ -s "$queue_failed_items_log_file" ]]; then
		while IFS= read -r item; do
			if [[ -f "$known_to_fail_log" ]] && grep -Fxq "$item" "$known_to_fail_log"; then
				known_to_fail+=("$item")
			else
				echo -e "██  \t\t\t\t\t\t  • $item"
			fi
		done < "$queue_failed_items_log_file"
	fi

	if [[ -s "$failed_file_log" ]]; then
		while IFS= read -r item; do
			if [[ -f "$known_to_fail_log" ]] && grep -Fxq "$item" "$known_to_fail_log"; then
				known_to_fail+=("$item")
			else
				echo -e "██  \t\t\t\t\t\t  • $item"
			fi
		done < "$failed_file_log"

		! $__quiet && echo -e "██"
	fi

	if (( "${#known_to_fail[@]}" > 0 )); then
		echo -e "██  List of items known to fail:"
		for item in "${known_to_fail[@]}"; do
		   echo -e "██  \t\t\t\t\t\t  • $item"
		done
	fi
}

function run_queue() {
	queue_name="$1"
	queue_file="$2"

	mkdir --parents -- "data/logs/"

	queue_log_file="data/logs/$queue_name-queue-$__current_date.log"
	touch -- "$queue_log_file"
	
	queue_failed_items_log_file="data/logs/$queue_name-failed-items-$__current_date.log"
	touch -- "$queue_failed_items_log_file"

	application_log_file="data/logs/$queue_name-application-$__current_date.log"
	touch -- "$application_log_file"

	error_log_file="data/logs/$queue_name-error-$__current_date.log"
	touch -- "$error_log_file"

	__setup_logging "$application_log_file" "$error_log_file"

	ln -nfs -- "$queue_log_file" "queue.log"
	ln -nfs -- "$queue_failed_items_log_file" "failed-items.log"
	ln -nfs -- "$application_log_file" "application.log"
	ln -nfs -- "$error_log_file" "error.log"

	__info "Start date: $__current_date"
	echo "Program arguments: $*" >> "$queue_log_file"

	! $__quiet && echo -e "\n\n"
	! $__quiet && echo -e "███████████████████████████████████████████████████████████████████████████████"
	! $__quiet && echo -e "██"
	echo -e "██  INFORMATION:\t\t\t\tStart of processing queue '$queue_name'."
	$__debug && echo -e "██  \t\t\t\t\t\t\t"
	! $__quiet && echo -e "██"
	! $__quiet && echo -e "██"
	! $__quiet && echo -e "██  Log file:\t\t\t\t\t$queue_log_file"
	! $__quiet && echo -e "██"
	! $__quiet && echo -e "██  Target Directory:\t\t\t$base_directory"
	! $__quiet && echo -e "██"
	! $__quiet && echo -e "██"
	! $__quiet && echo -e "▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔"
	! $__quiet && echo -e "\n"
	$__quiet && echo -e "\n"

	length=1
	current_line_number=1
	i=0

	queue_configuration_options_count=0
	queue_configuration_options=()
	queue_configuration_options_wideness=()

	data=()
	data_bag=()
	data_bag_item_count=1
	data_bag_line_marker_wideness_search_start=true
	data_bag_line_wideness=2

	# shellcheck source=/dev/null
	source -- "$queue_file" || exit 1

	data_counter=0
	data_length_counter="${#data[@]}"
	data_items_processed=0
	data_items_ignored=0
	data_items_failed=0
	data_items_success=0
	data_bag_incomplete=false

	for line in "${data[@]}"; do
		((data_counter++)) ||__expression_may_fail
		((data_length_counter--)) ||__expression_may_fail

		# insert marker found, continue
		if [[ "${line:0:1}" == "+" ]]; then
			((data_items_ignored--)) ||__expression_may_fail
			continue
		fi

		# stop marker found, exit
		if [[ "${line:0:1}" == "!" ]]; then
			if $data_bag_incomplete; then
				__error "ERROR! MALFORMED QUEUE DATA BAG: ITEM WINDOW TOO WIDE AT DATA ROW $((data_items_processed-data_items_ignored))"
				local_exit_failsafe
			fi
			((data_items_ignored--)) ||__expression_may_fail

			! $__quiet && echo -e "\n\n"
			! $__quiet && echo -e "▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁"
			! $__quiet && echo -e "██"

			if (( data_length_counter > 0 )); then
				echo -e "██  WARNING: process queue execution exists early, because a stop marker"
				echo -e "██           has been reached. This means that some data was not processed"
				echo -e "██           and data entries after the stop marker were skipped."
				echo -e "██           Last processed item: $data_items_processed"
			elif (( data_items_processed == 0 )); then
				echo -e "██  INFORMATION:\t\t\t\tqueue is empty."
			else
				echo -e "██  INFORMATION:\t\t\t\tqueue processing is now completed."
			fi
			$__debug && echo -e "██  \t\t\t\t\t\t\t"
			! $__quiet && echo -e "██"
			! $__quiet && echo -e "██"
			echo -e "██  Queue:\t\t\t\t\t\t$queue_name"
			! $__quiet && echo -e "██"
			echo -e "██  Items processed count:\t\t$data_items_processed"
			! $__quiet && echo -e "██"
			echo -e "██  Items failed count:\t\t\t$data_items_failed"
			! $__quiet && echo -e "██"
			list_failed_downloads
			! $__quiet && echo -e "██"
			! $__quiet && echo -e "███████████████████████████████████████████████████████████████████████████████"
			! $__quiet && echo -e "\n\n"
			$__quiet && echo -e "\n"

			break
		fi

		if (( data_length_counter == 0 )); then
			echo -e "\n\n"
			! $__quiet && echo -e "▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁"
			! $__quiet && echo -e "██"
			echo -e "██  Queue:\t\t\t\t$queue_name"
			! $__quiet && echo -e "██"
			! $__quiet && echo -e "██"
			echo -e "██  INFORMATION: queue is empty."
			$__debug && echo -e "██  \t\t\t\t\t\t\t"
			! $__quiet && echo -e "██"
			echo -e "██  Items processed count:\t$data_items_processed"
			! $__quiet && echo -e "██"
			echo -e "██  Items failed count:\t\t$data_items_failed"
			! $__quiet && echo -e "██"
			list_failed_downloads
			! $__quiet && echo -e "██"
			! $__quiet && echo -e "███████████████████████████████████████████████████████████████████████████████"
			! $__quiet && echo -e "\n\n"
			$__quiet && echo -e "\n"
		fi

		if $data_bag_line_marker_wideness_search_start; then
			data_bag_line_marker_wideness_search_start=false

			if [[ ! "$line" =~ ^[0-9]+$ ]] ; then
				__error "ERROR! MALFORMED QUEUE DATA BAG: INVALID WIDENESS VALUE AT DATA ROW $((data_items_processed-data_items_ignored))"
				local_exit_failsafe
			fi
			z=$((line+0)) ||__expression_may_fail
			data_bag_line_wideness="$z"
			data_bag_item_count=1
			data_bag=()

			continue # new data item line started with wideness prefix
		else
			((data_bag_item_count++)) ||__expression_may_fail

			if (( data_bag_item_count < data_bag_line_wideness )); then
				data_bag+=("$line")
				data_bag_incomplete=true

				continue # to collect data items
			fi

			for (( i=${#forwarded_parameters[@]}-1; i>=0; i-- )); do
				local value="${forwarded_parameters[i]}"
				__debug "%s" "forwarded_parameters=$value"
			done

			data_bag_incomplete=false

			previous_download=false
			original_url=""
			metadata_attached_queue=""

			reversed_data_bag=()
			for (( i=${#data_bag[@]}-1; i>=0; i-- )); do
				local value="${data_bag[i]}"
				__debug "%s" "data_bag=$value"
				__info "%s" "DD $force_download"
				if $force_download && [[ -f "data/$queue_name.queue" ]] && [[ "$value" = "--download-archive="* ]]; then
					__info "force_download is active, removing %s" "$value"
					: # filter parameter instance '--download-archive' in '--from-sources-file'-mode, so the queue archive index file can be ignored thus '--force-download' can be enforced properly
				elif [[ "$value" = "--metadata-"* ]]; then
					if [[ "$value" = "--metadata-in-memory="* ]]; then
						[[ "$value" == "--metadata-in-memory=true" ]] && previous_download=true
						#
					elif [[ "$value" = "--metadata-original-url="* ]]; then
						original_url="${value#*"="}"
					elif [[ "$value" = "--metadata-attach-queue="* ]]; then
						metadata_attached_queue="${value#*"="}"
					else
						: # filter all --metadata from queue processing
					fi
				else
					reversed_data_bag+=("$value")
				fi
			done



			local last_position
			last_position="$((${#reversed_data_bag[@]}-1))" ||__expression_may_fail
			url_cursor="$last_position"

			if (( url_cursor < 0 )); then
				__error "ERROR! MALFORMED QUEUE DATA BAG: ITEM WINDOW TOO NARROW AT DATA ROW $((data_items_processed-data_items_ignored))"
				local_exit_failsafe
			fi

			url="${reversed_data_bag[$url_cursor]}"

			if $previous_download && ! $ignore_memory; then
				__warn "URL %s is skipped from queue, it has previously been downloaded successfully." "$url"
				reversed_data_bag=()
				data_bag_line_marker_wideness_search_start=true
				continue
			fi

			if [[ -n "$metadata_attached_queue" ]]; then
				__info "URL %s is skipped from queue, because it resolves to an attached queue %s." "$url" "$metadata_attached_queue"

				reversed_data_bag=()
				data_bag_line_marker_wideness_search_start=true

				local metadata_attached_queue_name="${metadata_attached_queue%%":"*}"
				local metadata_attached_queue_file="${metadata_attached_queue#*":"}"
				attached_queues["$metadata_attached_queue_name"]="$metadata_attached_queue_file"

				continue
			fi

			for forward_parameter in "${forwarded_parameters[@]}"; do
				reversed_data_bag+=( "$forward_parameter" )
			done

			unset 'reversed_data_bag[url_cursor]'
			reversed_data_bag+=("--")
			reversed_data_bag+=("$url")

			data_bag_line_marker_wideness_search_start=true
		fi

		((data_items_processed++)) ||__expression_may_fail

		cursor=0
		for (( r = 0; r < queue_configuration_options_count; r++)); do
			wideness="${queue_configuration_options_wideness[r]}"

			local no_download_archive=false

			for queue_configuration_option in "${queue_configuration_options[@]:$cursor:$wideness}"; do
				__debug "%s" "queue_configuration_option=$queue_configuration_option"
				if [[ "$queue_configuration_option" == "--no-download-archive" ]]; then
					no_download_archive=true
				fi
			done

			queue_parameters=()
			for queue_configuration_option in "${queue_configuration_options[@]:$cursor:$wideness}"; do
				if $no_download_archive && [[ "$queue_configuration_option" = "--download-archive"* ]]; then
					: # filter parameter instance '--download-archive' when --no-download-archive is used, '--force-download', if enabled, adds its own date-based download archive/memory file a few lines below
				else
					queue_parameters+=("$queue_configuration_option")
				fi
			done

			current_data_bag=()
			for queue_configuration_option in "${reversed_data_bag[@]}"; do
				if $no_download_archive && [[ "$queue_configuration_option" = "--download-archive"* ]]; then
					: # filter parameter instance '--download-archive' when --no-download-archive is used, '--force-download', if enabled, adds its own date-based download archive/memory file a few lines below
				else
					current_data_bag+=("$queue_configuration_option")
				fi
			done

			if $force_download; then
				mkdir --parents -- "data/archive/" || exit 1
				#queue_parameters+=("--download-archive=$download_archive") # yt-dlp-specific
				queue_parameters+=("--no-download-archive") # yt-dlp-specific
			fi
			if $__verbose; then
				queue_parameters+=("--no-quiet" "--verbose") # yt-dlp-specific
			fi
			if $__debug; then
				queue_parameters+=("--no-quiet" "--verbose") # yt-dlp-specific
			fi
			if $ban_evasion; then
				queue_parameters+=("--sleep-subtitles" "5" "--sleep-requests" "0.75" "--min-sleep-interval" "10" "--max-sleep-interval" "20" "--retry-sleep" "fragment:12" "--no-cookies") # yt-dlp-specific
			fi
			if $write_comments; then
				queue_parameters+=("--write-comments") # yt-dlp-specific
			fi

			queue_parameters+=("--paths=$download_directory") # yt-dlp-specific

			mapfile -d '' -t site_configuration < <(determinate_site_configuration "$url")

			queue_parameters+=("${site_configuration[@]}" "--no-playlist")

			((cursor+=wideness)) ||__expression_may_fail

			! $__quiet && echo -e "███████████████████████████████████████████████████████████████████████████████"
			! $__quiet && echo -e "██"
			! $__quiet && echo -e "██  Queue:\t\t\t\t\t\t$queue_name"
			$__debug && echo -e "██"
			$__debug && echo -e "██  Log file:\t\t\t\t\t$queue_log_file"
			! $__quiet && echo -e "██"
			$__quiet && echo "$url"
			! $__quiet && echo -e "██  Resource:\t\t\t\t\t$url"
			$__debug && echo -e "██  \t\t\t\t\t\t\t"
			$__debug && echo -e "██"
			$__debug && echo -e "██"
			$__debug && echo -e "${queue_parameters[*]} ${current_data_bag[*]}\n"
			! $__quiet && echo -e "\n"

			return_value=0
			if ! $simulate; then
				if [[ -n "$original_url" ]]; then
					hook_url="$original_url"
				else
					hook_url="$url"
				fi

				$__debug && set -x
				# Executes target program!
				# The first argument of queue_parameters is the program executable name: '__configure_download yt-dlp […]'
				2> >(tee -a  -- "$error_log_file" | tee -a  -- "$queue_log_file" >&2) "${queue_parameters[@]}" --exec "before_dl:add_original_url_hook %(original_url)q %(filepath,_filename|)q ${hook_url@Q}" "${current_data_bag[@]}" | tee -a  -- "$queue_log_file" | tee -a  -- "$queue_log_file" || __expression_FF
				return_value=$?
				__enable_error_handler
				$__debug && set +x
			fi

			if (( return_value != 0 )); then
				echo -e "\n▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔"
				echo -e "ERROR:     \t\t\t\t\t\tDOWNLOAD FAILED!"
				echo -e "\n▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔"
				echo "$url" >> "$queue_failed_items_log_file"
				echo "$url" >> "$failed_file_log"
				((data_items_failed++)) ||__expression_may_fail
			else
				(( data_items_success++ )) ||__expression_may_fail
				! $__quiet && echo -e "\n▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔"
				! $__quiet && echo -e "     \t\t\t\t\t\t\tSUCCESS!"
				! $__quiet && echo -e "\n▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔\n\n\n"
			fi
			$__debug && echo "Data bag: ${current_data_bag[*]}" >> "$queue_log_file"

		done

		((current_line_number+=1)) ||__expression_may_fail
		((i+=length)) ||__expression_may_fail
	done

	if $force_download && [[ -e "$download_archive" ]]; then # yt-dlp-specific
		cat -- "${yt_ylp_default_download_index:?}" "$download_archive" >| "${yt_ylp_default_download_index:?}.tmp" && mv -- "${yt_ylp_default_download_index:?}.tmp" "${yt_ylp_default_download_index:?}"
	fi

	__setup_logging "" ""

	__erase_empty_file "$queue_log_file"
	__erase_empty_file "$queue_failed_items_log_file"
	__erase_empty_file "$application_log_file"
	__erase_empty_file "$error_log_file"

	echo -ne "" >| "data/logs/queue.log"
	echo -ne "" >| "data/logs/failed-items.log"
	echo -ne "" >| "data/logs/application.log"
	echo -ne "" >| "data/logs/error.log"

	[[ ! -f "$queue_log_file" ]] && ln -nfs -- "data/logs/queue.log" "queue.log" ||__expression_may_fail
	[[ ! -f "$queue_failed_items_log_file" ]] && ln -nfs -- "data/logs/failed-items.log" "failed-items.log" ||__expression_may_fail
	[[ ! -f "$application_log_file" ]] && ln -nfs -- "data/logs/application.log" "application.log" ||__expression_may_fail
	[[ ! -f "$error_log_file" ]] && ln -nfs -- "data/logs/error.log" "error.log" ||__expression_may_fail

	if (( data_items_success > 0 )); then
		if $regenerate_queue; then
			[[ -f "$local_queue" ]] && mv -- "$local_queue" "$base_directory/data/archive/$(basename -- "$local_queue").backup.$__current_date.replaced-by-update.backup"
			mv -- "$queue_file" "$local_queue"
			#__debug "%s" "mv -- $queue_file $local_queue"
			__info "Moved queue file %s" "mv -- $queue_file $local_queue"
		fi

		__info "Queue status is changed."
	else
		if $regenerate_queue; then
			[[ -f "$local_queue" ]] && mv -- "$local_queue" "$base_directory/data/archive/$(basename -- "$local_queue").backup.$__current_date.replaced-by-update.backup"
			mv -- "$queue_file" "$local_queue"
			#__debug "%s" "mv -- $queue_file $local_queue"
			__info "Moved queue file %s" "mv -- $queue_file $local_queue"
		fi

		__info "Queue status is unchanged, nothing to do."
	fi
}

function enqueue_download_from_file()
{
	local force_download1=false

	for option in "$@"; do
		if [[ "$option" =~ "--force" ]]; then
			force_download1=true
			shift ||__expression_may_fail
			break
		fi
	done

	local queue_name="$1"
	shift ||__expression_may_fail

	local sources_full_file_real_path="$1"
	shift ||__expression_may_fail

	local download_index="$1"
	shift ||__expression_may_fail

	additional_arguments=""
	$__verbose && additional_arguments="$additional_arguments--verbose "
	$__debug && additional_arguments="$additional_arguments--debug "
	$__quiet && additional_arguments="$additional_arguments--quiet "
	$ignore_memory && additional_arguments="$additional_arguments--ignore_memory "

	queue_full_file_path="data/archive/$queue_name-$__current_date.queue"
	cp -- "$__script_path/templates/$template_name.template" "$queue_full_file_path"

	local stop_marker_found=false
	declare -A processed_lines=()

	local url
	while read -r url; do
		if [[ "${url:0:6}" == "# STOP" ]]; then
			stop_marker_found=true
			break
		fi

		if [[ "$url" == "" || "$url" =~ ^[#[:space:]]+(.*)$ ]] || $stop_marker_found; then
			continue
		fi

		if [[ -v processed_lines["$url"] ]]; then
			__info "Duplicate url %s is ignored" "$url"
			continue
		fi

		processed_lines["$url"]=1

#
##
### Paste the functions above here
##
##echo "=== Test: Hashmap Round-Trip with Newlines ==="
##
##declare -A config
##
##config[url]="https://youtube.com/watch?v=abc123"
##config[title]=$'My Video\nwith actual newlines'
##config[description]=$'Line 1\nLine 2\nLine 3'
##config[channel]="UCxxxxxxxxxxxxxxxx"
##config[empty]=""
##config[k]="some value with \"quotes\" and \\backslashes"
##
##echo -e "\n--- Original Hashmap ---"
##for k in "${!config[@]}"; do
##    printf '  %-12s = [%s]\n' "$k" "${config[$k]}"
##done
