#exit

		if $force_download1; then
			enqueue-download $additional_arguments "--queue-name=$queue_name" "--queue-file=$local_queue" "--unit-name=a=sexy unit" "--download-archive=$download_index" "${template_name}:$queue_full_file_path" "$url"
		else
			enqueue-download $additional_arguments "--queue-name=$queue_name" "--queue-file=$local_queue" "--unit-name=a=sexy unit" "${template_name}:$queue_full_file_path" "$url"
		fi
	done < "$sources_full_file_real_path"
}

function handle_queue() {
    queue_file="$1"

	if [[ "$queue_file" =~ : ]]; then
		echo "queue file do not allow for a selector format"
		exit
    fi

    queue_name="$(basename -- "${queue_file%.*}")"

	local f
	if [[ "${queue_file:0:2}" == "./" || "${queue_file:0:1}" == "/" ]]; then
		f="$queue_file"
    else
		base_directory="$application_var_directory/"
		f="$base_directory/queues/$queue_file.queue" #@todo fixme
	fi

	queue_full_file_path="$queue_file"
	queue_full_file_path="$(realpath --quiet --canonicalize-missing -- "$f")"
	queue_name="$(basename -- "${queue_full_file_path%.*}")"

	base_directory="$base_directory/🔴.undownloaded"
    if [[ -n "$target_directory" ]]; then
    	download_directory="$target_directory/"
    else
		local queue_path="$(dirname -- "${queue_full_file_path%.*}")"
		base_directory="$queue_path/🔴.undownloaded/"
		download_directory="$queue_path/🔴.undownloaded/files/"
    fi

	__debug "queue_name=$queue_name"
    __debug "PWD=$PWD"
    __debug "base_directory=$base_directory"
    __debug "download_directory=$download_directory"
	__debug "queue_full_file_path=$queue_full_file_path"

	if [[ ! -f "$queue_full_file_path" ]]; then
		__error "queue file %s does not exist" "$queue_full_file_path"
		local_exit_failsafe
	fi

	mkdir --parents -- "$base_directory"
	cd "$base_directory/" || exit 1
	mkdir --parents -- "data/archive/" || exit 1

	download_archive="$base_directory/data/$queue_name.memory"

	$__debug && echo -e "queue file:\n$queue_full_file_path" && cat -- "$queue_full_file_path" && __press_any_key_to_continue

	attached_queues=()
	run_queue "$queue_name" "$queue_full_file_path"

	local attached_queue_name
	for attached_queue_name in "${!attached_queues[@]}"; do
		local attached_queue_file_full_file_path="${attached_queues[$attached_queue_name]}"
		local_queue="data/$attached_queue_name"
		run_queue "$(basename -- "$attached_queue_file_full_file_path")" "$attached_queue_file_full_file_path"
	done
	attached_queues=()
}

function handle_source_list() {
	local file_selector="$1"

	handle_source_selector "$file_selector"

	mkdir --parents -- "$base_directory"
	cd "$base_directory/" || exit 1
	mkdir --parents -- "data/archive/" || exit 1

	failed_file_log="$(realpath --quiet -- "$unit_name.failed")"
	known_to_fail_log="$(realpath --quiet -- "$unit_name.known.failed")"

	queue_template_full_file_path="$__script_path/templates/$template_name.template"

	if [[ ! -f "$sources_full_file_real_path" ]]; then
		__error "sources file '$sources_full_file_real_path' does not exist"
		exit 0
	fi

	if [[ ! -f "$queue_template_full_file_path" ]]; then
		__error "ERROR: queue template file '$queue_template_full_file_path' does not exist"
		local_exit_failsafe
	fi

	local_download_index="data/$queue_name.memory"
	local_queue="data/$queue_name.queue"

	if $forget_downloads && [[ -f "$local_download_index" ]]; then
		mkdir --parents -- "$base_directory/data/archive" && mv -- "$local_download_index" "$base_directory/data/archive/$(basename -- "$local_download_index").$__current_date.backup"
	fi

	if [[ -f "$local_queue" ]] && ! $fetch; then
		regenerate_queue=false
		if $force_download; then
			download_archive="data/archive/$__current_date.memory"
		else
			download_archive="$local_download_index"
		fi

		queue_full_file_path="$(realpath --quiet -- "$local_queue")"

		$__debug && echo -e "queue file:\n$queue_full_file_path" && cat -- "$queue_full_file_path" && __press_any_key_to_continue

		attached_queues=()
		run_queue "$queue_name" "$queue_full_file_path"

		local attached_queue_name
		for attached_queue_name in "${!attached_queues[@]}"; do
			local attached_queue_file_full_file_path="${attached_queues[$attached_queue_name]}"
			local_queue="data/$attached_queue_name"
			run_queue "$(basename -- "$attached_queue_file_full_file_path")" "$attached_queue_file_full_file_path"
		done
		attached_queues=()
	else
		regenerate_queue=true
		download_archive="$local_download_index"

		#if $fetch && [[ -f "$download_archive" ]] && $forget_downloads; then
		#if $forget_downloads && [[ -f "$download_archive" ]]; then
		#	mkdir --parents -- "$base_directory/data/archive" && mv -- "$download_archive" "$base_directory/data/archive/$(basename -- "$download_archive").$__current_date.backup"
		#fi

		echo -e "██  generating queue from:\t\t$sources_file_name\n"

		queue_full_file_path=""
		enqueue_download_from_file --force "$queue_name" "$sources_full_file_real_path" "$download_archive"

		echo -e "\n\n"

		# disabled, because the generated queue contains another parameter instance of "download_archive"
		#force_download=false #  so the argument that effectively turns on force_download must be ignored.
		# you can't have multiple instances – yt-dlp will take only the last one.

		$__debug && echo -e "queue file:\n$queue_full_file_path" && cat -- "$queue_full_file_path" && __press_any_key_to_continue

		queue_full_file_path="$(realpath --quiet -- "$queue_full_file_path")"

		attached_queues=()
		run_queue "$queue_name" "$queue_full_file_path"

		local attached_queue_name
		for attached_queue_name in "${!attached_queues[@]}"; do
			local attached_queue_file_full_file_path="${attached_queues[$attached_queue_name]}"
			local_queue="data/$attached_queue_name"
			run_queue "$(basename -- "$attached_queue_file_full_file_path")" "$attached_queue_file_full_file_path"
		done
		attached_queues=()

		remote_download_archive="data/archive/$queue_name.$__current_date.memory"
		if [[ -f "$local_download_index" ]]; then
			cp -- "$local_download_index" "$remote_download_archive"
		fi
	fi
}

given_files+=("$@")
if (( ${#given_files[@]} == 0 )); then
	if (( ${#default_queues[@]} != 0 )); then
		given_files=("${default_queues[@]}")
	else
		for sources_file in "$application_var_directory/sources"/*.sources; do
			[[ -e "$sources_file" ]] || continue
			given_files+=("$sources_file")
		done
	fi
else
	given_files=("${given_files[@]}")
fi

view_file="" #@ temporary debug solution

for file in "${given_files[@]}"; do
	__heading "File: %s" "$file"
	file_extension="${file##*.}"

	if [[ "$file_extension" == "sources" ]]; then
		sources_file="$file"

		if $print_sources_files; then
			parse_sources_file "$sources_file"
			print_tree
			exit 0
		else
			$__debug && print_tree
		fi

		( handle_source_list "$sources_file" )
	elif [[ "$file_extension" == "queue" ]]; then
		queue_file="$file"

    	( handle_queue "$queue_file" )
	else
		sources_file="$file.sources"

		if $print_sources_files; then
			parse_sources_file "$sources_file"
			print_tree
			exit 0
		else
			$__debug && print_tree
		fi

		( handle_source_list "$sources_file" )
	fi
	view_file="$file"
done

additional_arguments=""
$force_view_update && additional_arguments="$additional_arguments--force-view-update "
$__verbose && additional_arguments="$additional_arguments--verbose "
$__debug && additional_arguments="$additional_arguments--debug "
$__quiet && additional_arguments="$additional_arguments--quiet "

#__info "! Calling view %s" "$view_file"
#undownloader-view "$view_file" --update-all $additional_arguments
__info "! Calling view(s)"
undownloader-view --all $additional_arguments
