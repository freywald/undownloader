##    echo -e "\n✅ Newlines preserved correctly"
##else
##    echo -e "\n❌ Newline mismatch"
##fi
##exit
#
#serialized='h="hello world" s="it has \"quotes\"" b="path/with\\backslash" e=""'
#
#echo -e "serialized string:\n$serialized"
#declare -A my_map
#
#unserialize_into_map "$serialized" "my_map" "orde"
#
##echo -e "\nParsed into hashmap:"
##dump_map "my_map" "orde"
#
##dump_array "my_map"
##exit
#result="$(serialize_map "my_map" "orde")"
#echo -e "serialized string from map:\n$result"
