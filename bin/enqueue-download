#!/bin/bash

if (( $# == 0 )); then
	echo "Usage: $0 <queue name> <download data+URL>"
	echo "Usage: $0 <queue template name>:<queue file location> <download data+URL>"
	exit 1
fi

source -- "$(realpath "$(dirname -- "${BASH_SOURCE[-1]}")/../")/library/base" || exit 1
__set_script_path
__enable_error_handler
function local_exit_failsafe() { __exit_failsafe; exit 1; }

source -- "$__script_path/library/main" || exit 1
source -- "$__script_path/configuration/defaults" || exit 1

download_archive=""
for option in "$@"; do
	if [[ "$option" =~ "--force" ]]; then
		force_download=true
		shift ||__expression_may_fail
	elif [[ "$option" =~ "--quiet" ]]; then
		__quiet=true
		shift ||__expression_may_fail
	elif [[ "$option" =~ "--verbose" ]]; then
		__verbose=true
		shift ||__expression_may_fail
	elif [[ "$option" =~ "--debug" ]]; then
		__debug=true
		shift ||__expression_may_fail
	elif [[ "$option" =~ "--download-archive"* ]]; then
		download_archive="$1"
		shift ||__expression_may_fail
	fi
done

if [[ -z "$1" ]]; then
	__error "Queue file not given"
	__exit_failsafe
fi

template_name="${1%:*}"
queue_full_file_path="${1#*:}"

if [[ "$queue_full_file_path" == "$template_name" ]]; then
	queue_file="$application_var_directory/queues/$template_name.queue"
else
	queue_file="$queue_full_file_path"
	# @fixme verify if given $1 = "axudio:/home/ju/Daten1/var/undownloader/application/queues/foobar_music.queue"
	# that $template_name axudiozzz is the correct template name for the queue (which it is not, the string is erroneously accepted)
fi

if [[ ! -f "$queue_file" ]]; then
	__error "Queue file '%s' does not exist" "$queue_file"
	__exit_failsafe
fi

queue_name="$queue_full_file_path"
shift ||__expression_may_fail

function handle_line() {
	local parameters=()

	#echo "1=${1:-?}"
	#echo "2=${2:-?}"
	#echo "3=${3:-?}"
	#echo "4=${4:-?}"

	#read -ra parameter_input_array <<< "$@"
	#for parameter in "${parameter_input_array[@]}"; do

	for parameter in "$@"; do
		parameters+=( "\"$parameter\"" )
	done

	line="$1"
    local separator=" --"$'\t'
    local escaped_separator=" --\\"$'\t'
    line="${line//"$escaped_separator"/"$separator"}" #unescape input

    url_changed=false

	local unit_name
	unit_name="$(basename -- "$queue_name")"
	unit_name="${unit_name%%-*}"

	main_directory="$(realpath --canonicalize-missing --quiet -- "$PWD/../")"

	local failed_file_log
	failed_file_log="$main_directory/$unit_name.failed"

	local known_failed_file_log
	known_failed_file_log="$main_directory/$unit_name.known.failed"

	local current_fails_file_log
	current_fails_file_log="$main_directory/$unit_name-queue-$__current_date.fails"

    local arguments="${line%%"$separator"*}"
    local parameter_url="${line#*"$separator"}"

	parameter_url_unsanitized="$parameter_url"
	parameter_url="$(sanitize_url "$parameter_url")"
	if [[ "$parameter_url_unsanitized" != "$parameter_url" ]]; then
		__verbose "URL un-sanitized %s" "$parameter_url_unsanitized"
		__verbose "URL sanitized %s" "$parameter_url"
		url_changed=true
	fi

	__info "Video URL %s" "$parameter_url"
	__verbose "Looking up URL in memory file %s" "$PWD/data/$unit_name.memory"

	if [[ -f "$PWD/data/$unit_name.memory" ]] && is_url_in_memory_file "$parameter_url" "$PWD/data/$unit_name.memory"; then
		__verbose "URL %s is skipped because it has previously been downloaded successfully." "$parameter_url"
		return
	fi

	if [[ "$parameter_url" =~ ^(https://)(.+\.)?(youtube\.[^/]+|youtu\.be)/ ]]; then
		__verbose "Looking for a playlist URL for the youtube video from the same channel"
		local parameter_url2
		parameter_url2="$parameter_url"
		local new_video_url

		if new_video_url="$(handle_youtube_url "$parameter_url")"; then
			if [[ -n "$new_video_url" ]]; then
				url_changed=true
				parameter_url="$new_video_url"
				if [[ "$parameter_url2" != "$parameter_url" ]]; then
					__verbose "New video URL %s" "$parameter_url"
				fi
			fi
		else
			__warn "URL %s failed!" "$parameter_url"

			if [[ -f "$known_failed_file_log" ]] && grep --quiet -- "^$parameter_url_unsanitized$" "$known_failed_file_log" > "/dev/null"; then
				__warn "URL %s IS A KNOWN FAIL!" "$parameter_url"
			fi

			echo "$parameter_url_unsanitized" >> "$current_fails_file_log"

			if [[ -f "$known_failed_file_log" && -f "$failed_file_log" ]] && ! grep --quiet -- "^$parameter_url_unsanitized$" "$known_failed_file_log" > "/dev/null" && ! grep --quiet -- "^$parameter_url_unsanitized$" "$failed_file_log" > "/dev/null"; then
				echo "$parameter_url_unsanitized" >> "$failed_file_log"
			elif [[ ! -f "$known_failed_file_log" ]]; then
				if [[ -f "$failed_file_log" ]]; then
					if ! grep --quiet -- "^$parameter_url_unsanitized$" "$failed_file_log" > "/dev/null"; then
						echo "$parameter_url_unsanitized" >> "$failed_file_log"
					fi
				elif [[ ! -f "$failed_file_log" ]]; then
					echo "$parameter_url_unsanitized" >> "$failed_file_log"
				fi
			fi

			return
		fi
	else
		__info "%s is not a youtube link" "$parameter_url"
	fi

	if $url_changed; then
		parameters+=( "\"--metadata-source-url=\\\"$parameter_url_unsanitized\\\"\"" )
	fi

    if [[ "$parameter_url" != "$arguments" ]]; then
		parameters[0]="\"$parameter_url\""
	else
		arguments=""
	fi

	for arguments in $arguments; do
		parameters+=( "\"$arguments\"" )
	done

	item_count="${#parameters[@]}"

	if ! $force_download; then
		line="${parameters[*]}"
	else
		line="${parameters[*]} \"--download-archive=data/archive/$__current_date.memory\""
		((item_count++)) ||__expression_may_fail
	fi

	line="$((2+item_count)) $line -- " # item_count +2 because: "––" and item_count itself are counted as two additional items

	# source: https://blog.stigok.com/2018/05/31/surprising-sed-replace-uri-with-ampersand.html
	# escape certain characters
	line=$(sed 's/[&/\]/\\&/g' <<< "$line")

	# source: https://unix.stackexchange.com/questions/188264/how-do-i-substitute-only-first-occurence-with-sed
	# insert download data below top-most "+ \" insertion marker, but none other if existing
	sedex="/^+ \\\/{s//+ \\\\\n$line\\\/;:p;n;bp}"

	sed -i "$sedex" "$queue_file" && __info "The url %s is appended to queue %s" "${parameters[0]}" "$queue_name"

	# link-muddler-delete-link "${parameters[0]}" #@fixme
}

if [[ -z "${1:-}" ]]; then
	previous_line="?"
	echo "No data provided, entering INPUT MODE, use linebreak to exit"

	while true; do
		read -r line
		mapfile -t lines < <(xargs -n1 printf '%s\n' <<< "$(__trim_string_balanced "$line" \")")
		set -- "${lines[@]}"

	#echo "1=${1:-?}"
	#echo "2=${2:-?}"
	#echo "3=${3:-?}"
	#echo "4=${4:-?}"
	#echo "l=$# a=$*"

		if (( $# > 0 )) && [[ $1 != "" ]]; then
			handle_line "$@" "$download_archive"
		else
			line=""
		fi

		if [[ "${previous_line}${line}" == "" ]]; then #both are empty
			break
		fi

		previous_line="$line"
	done
else
	#echo "1=${1:-?}"
	#echo "2=${2:-?}"
	#echo "3=${3:-?}"
	#echo "4=${4:-?}"
	#echo "l=$# a=$*"

	handle_line "$@" "$download_archive"
fi

