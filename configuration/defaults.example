#!/bin/bash

default_target_directory="$HOME/var/undownloader/files/"
export default_target_directory

yt_ylp_default_download_index="$HOME/.config/yt-dlp/download-index.txt"
export yt_ylp_default_download_index

default_template_name="audio"
export default_template_name

default_queues=(
"video"
"audio+video"
"audio"
)
export default_queues

# install

application_var_directory="/home/$USER/Daten1/var/undownloader/application"
export application_var_directory

base_configuration=("-4" "--no-overwrites" "--cookies" "/home/ju/.config/yt-dlp/cookies-youtube.txt" "--extractor-args" "youtubepot-bgutilscript:server_home=/home/ju/.config/yt-dlp/bgutil-ytdlp-pot-provider/server/")

declare -A base_configuration_site=()
base_configuration_site["rumble"]='--impersonate=firefox;'
base_configuration_site["youtube"]=''

declare -A host_match_name=(
    ['^(([^.]+\.)+)?(youtube\.com|youtu\.be)$']="youtube"
    ['^(([^.]+\.)+)?rumble\.com$']="rumble"
    ['^(([^.]+\.)+)?bbc\.co\.uk$']="bbc"
)

default_view_name="music"

default_sources_name="music"
