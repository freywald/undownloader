  # "PLAYLIST/{{channel|uploader_id|uploader}}/{{playlist_title|playlist|'Unknown Playlist'}}{{( :release_year:)|( :release_date:)|?}}/{{playlist_index%03d}}. {{title}}{{ (u:upload_date?:)}} [{{id}}].{{file_extension}}" #@TODO both should behave the same
   # "PLAYLIST/{{channel|uploader_id|uploader}}/{{playlist_title|playlist|'Unknown Playlist'}}{{( :release_year:)|( :release_date:)|''?}}/{{playlist_index%03d}}. {{title}}{{ (u:upload_date?:)}} [{{id}}].{{file_extension}}" #@TODO both should behave the same
	#"PLAYLIST/{{channel|uploader_id|uploader}}/{{playlist_title|playlist|'Unknown Playlist'}}{{( :release_year:)|( :release_date:)|'X'?}}/{{playlist_index%03d}}. {{title}}{{ (u:upload_date?:)}} [{{id}}].{{file_extension}}" #@TODO both should behave the same


