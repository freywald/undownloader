#formatters=("{{a:release_year?:b}}[{{id}}].{{file_extension}}")
#release_year is null

field_format__timestamp() {
    local input="$1"

    [[ -z "$input" ]] && { echo ""; return; }

    local date_str=""

    if [[ "$input" =~ ^[0-9]{1,10}$ ]]; then
        date_str="@$input"
    # Case 3: Already ISO-like or other formats - pass through to date
    else
        date_str="$input"
    fi

    # Convert to desired format
    date -d "$date_str" '+%d.%m.%Y' 2>"/dev/null" || echo "$input"
}

formatter__failure(){
	local input="$1"

    [[ -z "$input" ]] && { echo ""; return; }
    echo "***${input}***"
}
